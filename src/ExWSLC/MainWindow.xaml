<ui:FluentWindow x:Class="ExWSLC.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="ExWSLC" Width="1320" Height="860" MinWidth="1050" MinHeight="700"
                 WindowStartupLocation="CenterScreen" WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="ExWSLC" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{ui:ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ui:ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource PreviewNotice}" TextWrapping="Wrap" Opacity=".65" Margin="8,8,8,18" FontSize="11"/>
                        <Button Tag="0" Click="NavigationButton_Click" Content="{DynamicResource NavOverview}" Margin="0,2" Padding="12,9" HorizontalContentAlignment="Left"/>
                        <Button Tag="1" Click="NavigationButton_Click" Content="{DynamicResource NavContainers}" Margin="0,2" Padding="12,9" HorizontalContentAlignment="Left"/>
                        <Button Tag="2" Click="NavigationButton_Click" Content="{DynamicResource NavImages}" Margin="0,2" Padding="12,9" HorizontalContentAlignment="Left"/>
                        <Button Tag="3" Click="NavigationButton_Click" Content="{DynamicResource NavResources}" Margin="0,2" Padding="12,9" HorizontalContentAlignment="Left"/>
                        <Button Tag="4" Click="NavigationButton_Click" Content="{DynamicResource NavTasks}" Margin="0,2" Padding="12,9" HorizontalContentAlignment="Left"/>
                    </StackPanel>
                    <Button Grid.Row="2" Tag="5" Click="NavigationButton_Click" Content="{DynamicResource NavSettings}" Margin="0,2" Padding="12,9" HorizontalContentAlignment="Left"/>
                </Grid>
            </Border>

            <TabControl Grid.Column="1" SelectedIndex="{Binding SelectedPageIndex}" Background="Transparent" BorderThickness="0">
                <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="26">
                            <DockPanel><TextBlock Text="{DynamicResource OverviewTitle}" Style="{StaticResource PageTitleStyle}"/><Button DockPanel.Dock="Right" Content="{DynamicResource Refresh}" Command="{Binding RefreshAllCommand}" Padding="18,7" Margin="10,0,0,18"/></DockPanel>
                            <UniformGrid Columns="5">
                                <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="{DynamicResource Running}" Opacity=".65"/><TextBlock Text="{Binding RunningContainerCount}" FontSize="32" FontWeight="SemiBold" Foreground="#24A148"/></StackPanel></Border>
                                <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="{DynamicResource Stopped}" Opacity=".65"/><TextBlock Text="{Binding StoppedContainerCount}" FontSize="32" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="{DynamicResource Images}" Opacity=".65"/><TextBlock Text="{Binding ImageCount}" FontSize="32" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="{DynamicResource Networks}" Opacity=".65"/><TextBlock Text="{Binding NetworkCount}" FontSize="32" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="{DynamicResource Volumes}" Opacity=".65"/><TextBlock Text="{Binding VolumeCount}" FontSize="32" FontWeight="SemiBold"/></StackPanel></Border>
                            </UniformGrid>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel><TextBlock Text="{DynamicResource Environment}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding VersionSummary}" FontFamily="Consolas"/><TextBlock Text="{Binding Capabilities.Message}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel><TextBlock Text="{DynamicResource LiveStats}" Style="{StaticResource SectionTitleStyle}"/>
                                    <DataGrid ItemsSource="{Binding Stats}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MinHeight="170">
                                        <DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="120"/><DataGridTextColumn Header="Memory" Binding="{Binding Memory}" Width="170"/><DataGridTextColumn Header="Network I/O" Binding="{Binding NetworkIo}" Width="170"/><DataGridTextColumn Header="Block I/O" Binding="{Binding BlockIo}" Width="170"/><DataGridTextColumn Header="PIDs" Binding="{Binding Pids}" Width="80"/></DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <Grid Margin="26">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource ContainersTitle}" Style="{StaticResource PageTitleStyle}"/>
                            <Expander Header="{DynamicResource CreateContainer}" IsExpanded="False" Margin="0,0,0,14">
                                <Border Style="{StaticResource CardStyle}" Margin="0,8,0,8">
                                    <StackPanel>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource Image}"/><TextBox Text="{Binding NewImage, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="{DynamicResource Name}"/><TextBox Text="{Binding NewContainerName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource Command}"/><TextBox Text="{Binding NewCommand, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                        </Grid>
                                        <Expander Header="{DynamicResource Advanced}" Margin="0,12,0,0">
                                            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                <StackPanel Margin="0,0,10,8"><TextBlock Text="CPU (e.g. 1.5)"/><TextBox Text="{Binding NewCpuLimit}"/></StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,10,8"><TextBlock Text="Memory (e.g. 512M)"/><TextBox Text="{Binding NewMemoryLimit}"/></StackPanel>
                                                <StackPanel Grid.Column="2" Margin="0,0,0,8"><TextBlock Text="Network"/><TextBox Text="{Binding NewNetwork}"/></StackPanel>
                                                <StackPanel Grid.Row="1" Margin="0,0,10,8"><TextBlock Text="Environment (KEY=VALUE)"/><TextBox Text="{Binding NewEnvironment}" AcceptsReturn="True" Height="50"/></StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,8"><TextBlock Text="Ports (8080:80)"/><TextBox Text="{Binding NewPorts}" AcceptsReturn="True" Height="50"/></StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8"><TextBlock Text="Volumes (source:target)"/><TextBox Text="{Binding NewVolumes}" AcceptsReturn="True" Height="50"/></StackPanel>
                                                <StackPanel Grid.Row="2" Margin="0,0,10,0"><TextBlock Text="User"/><TextBox Text="{Binding NewUser}"/></StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Workdir"/><TextBox Text="{Binding NewWorkingDirectory}"/></StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="2"><CheckBox Content="All GPUs" IsChecked="{Binding NewUseAllGpus}"/><CheckBox Content="Remove when stopped" IsChecked="{Binding NewRemoveWhenStopped}" Margin="0,6,0,0"/></StackPanel>
                                            </Grid>
                                        </Expander>
                                        <Button Content="{DynamicResource Run}" Command="{Binding RunNewContainerCommand}" HorizontalAlignment="Right" Padding="24,8" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Expander>
                        </StackPanel>
                        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Search}" Margin="0,0,0,8"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding VisibleContainers}" SelectedItem="{Binding SelectedContainer}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Image" Binding="{Binding Image}" Width="*"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="100"/><DataGridTextColumn Header="Ports" Binding="{Binding Ports}" Width="150"/></DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                                <TextBlock Text="{Binding SelectedContainer.Name, TargetNullValue=Select a container}" FontSize="21" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedContainer.Id}" FontFamily="Consolas" Opacity=".6" Margin="0,4,0,14"/>
                                <WrapPanel><Button Content="{DynamicResource Start}" Command="{Binding StartContainerCommand}" Margin="0,0,6,6"/><Button Content="{DynamicResource Stop}" Command="{Binding StopContainerCommand}" Margin="0,0,6,6"/><Button Content="{DynamicResource Restart}" Command="{Binding RestartContainerCommand}" Margin="0,0,6,6"/><Button Content="{DynamicResource Kill}" Command="{Binding KillContainerCommand}" Margin="0,0,6,6"/><Button Content="{DynamicResource Remove}" Command="{Binding RemoveContainerCommand}" Margin="0,0,6,6"/><Button Content="{DynamicResource Export}" Command="{Binding ExportContainerCommand}" Margin="0,0,6,6"/></WrapPanel>
                                <WrapPanel Margin="0,6,0,8"><Button Content="{DynamicResource Logs}" Command="{Binding ShowLogsCommand}" Margin="0,0,6,6"/><Button Content="{DynamicResource FollowLogs}" Command="{Binding FollowLogsCommand}" Margin="0,0,6,6"/><Button Content="{DynamicResource StopFollowing}" Command="{Binding StopFollowingLogsCommand}" Margin="0,0,6,6"/><Button Content="{DynamicResource Inspect}" Command="{Binding InspectContainerCommand}" Margin="0,0,6,6"/><Button Content="{DynamicResource Terminal}" Command="{Binding OpenTerminalCommand}" Margin="0,0,6,6"/></WrapPanel>
                                <DockPanel Margin="0,4,0,8"><Button DockPanel.Dock="Right" Content="{DynamicResource Exec}" Command="{Binding ExecCommand}" Margin="6,0,0,0"/><TextBox Text="{Binding ExecText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/></DockPanel>
                                <TextBlock Text="{DynamicResource Output}" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBox Text="{Binding DetailOutput}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinHeight="250"/>
                            </StackPanel></ScrollViewer></Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource ImagesTitle}" Style="{StaticResource PageTitleStyle}"/>
                        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <DataGrid ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,12,0">
                                <DataGrid.Columns><DataGridTextColumn Header="Repository" Binding="{Binding Repository}" Width="*"/><DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="120"/><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="160"/><DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100"/></DataGrid.Columns>
                            </DataGrid>
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"><StackPanel><TextBlock Text="Image operations" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Image reference"/><TextBox Text="{Binding ImageReference}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Path / build context"/><TextBox Text="{Binding ImagePath}" Margin="0,0,0,8"/>
                                    <TextBlock Text="New tag"/><TextBox Text="{Binding ImageTag}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Dockerfile path (optional)"/><TextBox Text="{Binding DockerfilePath}" Margin="0,0,0,10"/>
                                    <WrapPanel><Button Content="{DynamicResource Pull}" Command="{Binding PullImageCommand}" Margin="0,0,6,6"/><Button Content="{DynamicResource Build}" Command="{Binding BuildImageCommand}" Margin="0,0,6,6"/><Button Content="{DynamicResource Import}" Command="{Binding ImportImageCommand}" Margin="0,0,6,6"/><Button Content="{DynamicResource Load}" Command="{Binding LoadImageCommand}" Margin="0,0,6,6"/><Button Content="{DynamicResource Save}" Command="{Binding SaveImageCommand}" Margin="0,0,6,6"/><Button Content="{DynamicResource Tag}" Command="{Binding TagImageCommand}" Margin="0,0,6,6"/><Button Content="{DynamicResource Push}" Command="{Binding PushImageCommand}" Margin="0,0,6,6"/><Button Content="{DynamicResource Inspect}" Command="{Binding InspectImageCommand}" Margin="0,0,6,6"/><Button Content="{DynamicResource Remove}" Command="{Binding RemoveImageCommand}" Margin="0,0,6,6"/><Button Content="{DynamicResource Prune}" Command="{Binding PruneCommand}" CommandParameter="image" Margin="0,0,6,6"/></WrapPanel>
                                </StackPanel></Border>
                                <TextBox Text="{Binding DetailOutput}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" MinHeight="250" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            </StackPanel></ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource ResourceTitle}" Style="{StaticResource PageTitleStyle}"/>
                        <DockPanel Grid.Row="1" Margin="0,0,0,12"><TextBox Text="{Binding ResourceName}" MinWidth="260"/><Button Content="Create network" Command="{Binding CreateNetworkCommand}" Margin="8,0"/><Button Content="Create volume" Command="{Binding CreateVolumeCommand}"/></DockPanel>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{DynamicResource Networks}" Style="{StaticResource SectionTitleStyle}"/><DataGrid Grid.Row="1" ItemsSource="{Binding Networks}" SelectedItem="{Binding SelectedNetwork}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Driver" Binding="{Binding Driver}" Width="120"/><DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="100"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="2" Margin="0,10,0,0"><Button Content="{DynamicResource Inspect}" Command="{Binding InspectNetworkCommand}" Margin="0,0,6,0"/><Button Content="{DynamicResource Remove}" Command="{Binding RemoveNetworkCommand}" Margin="0,0,6,0"/><Button Content="{DynamicResource Prune}" Command="{Binding PruneCommand}" CommandParameter="network"/></WrapPanel></Grid></Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{DynamicResource Volumes}" Style="{StaticResource SectionTitleStyle}"/><DataGrid Grid.Row="1" ItemsSource="{Binding Volumes}" SelectedItem="{Binding SelectedVolume}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Driver" Binding="{Binding Driver}" Width="100"/><DataGridTextColumn Header="Mountpoint" Binding="{Binding Mountpoint}" Width="2*"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="2" Margin="0,10,0,0"><Button Content="{DynamicResource Inspect}" Command="{Binding InspectVolumeCommand}" Margin="0,0,6,0"/><Button Content="{DynamicResource Remove}" Command="{Binding RemoveVolumeCommand}" Margin="0,0,6,0"/><Button Content="{DynamicResource Prune}" Command="{Binding PruneCommand}" CommandParameter="volume"/></WrapPanel></Grid></Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel><TextBlock Text="{DynamicResource TasksTitle}" Style="{StaticResource PageTitleStyle}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="{DynamicResource CancelCurrent}" Command="{Binding CancelCurrentOperationCommand}" Padding="16,7" Margin="8,0,0,18"/><Button Content="{DynamicResource ClearCompleted}" Command="{Binding ClearTasksCommand}" Padding="16,7" Margin="8,0,0,18"/></StackPanel></DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Tasks}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Task" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="120"/><DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="3*"/><DataGridTextColumn Header="Started" Binding="{Binding StartedAt}" Width="170"/><DataGridTextColumn Header="Finished" Binding="{Binding FinishedAt}" Width="170"/></DataGrid.Columns></DataGrid>
                    </Grid>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="26"><TextBlock Text="{DynamicResource SettingsTitle}" Style="{StaticResource PageTitleStyle}"/>
                        <Border Style="{StaticResource CardStyle}" MaxWidth="760" HorizontalAlignment="Left"><StackPanel><TextBlock Text="{DynamicResource Appearance}" Style="{StaticResource SectionTitleStyle}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0"><TextBlock Text="{DynamicResource Language}"/><ComboBox SelectedValue="{Binding SelectedLanguage}" SelectedValuePath="Content"><ComboBoxItem Content="zh-CN"/><ComboBoxItem Content="en-US"/></ComboBox></StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="{DynamicResource Theme}"/><ComboBox SelectedValue="{Binding SelectedTheme}" SelectedValuePath="Content"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource RefreshInterval}"/><TextBox Text="{Binding RefreshIntervalSeconds}"/></StackPanel>
                            </Grid><WrapPanel Margin="0,14,0,0"><Button Content="{DynamicResource SaveSettings}" Command="{Binding SaveSettingsCommand}" Margin="0,0,8,6"/><Button Content="{DynamicResource NativeSettings}" Command="{Binding OpenNativeSettingsCommand}" Margin="0,0,8,6"/><Button Content="{DynamicResource ResetNativeSettings}" Command="{Binding ResetNativeSettingsCommand}" Margin="0,0,8,6"/><Button Content="{DynamicResource InstallComponents}" Command="{Binding InstallComponentsCommand}" Margin="0,0,8,6"/></WrapPanel>
                        </StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}" MaxWidth="760" HorizontalAlignment="Left"><StackPanel><TextBlock Text="{DynamicResource RegistryLogin}" Style="{StaticResource SectionTitleStyle}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0"><TextBlock Text="{DynamicResource Server}"/><TextBox Text="{Binding RegistryServer}"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="{DynamicResource Username}"/><TextBox Text="{Binding RegistryUsername}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource Password}"/><PasswordBox PasswordChanged="RegistryPasswordBox_OnPasswordChanged"/></StackPanel>
                            </Grid><Button Content="{DynamicResource Login}" Command="{Binding LoginRegistryCommand}" HorizontalAlignment="Right" Padding="22,7" Margin="0,14,0,0"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}" MaxWidth="760" HorizontalAlignment="Left"><StackPanel><TextBlock Text="{DynamicResource Environment}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding VersionSummary}" FontFamily="Consolas"/><TextBlock Text="{Binding Capabilities.Message}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2" Background="{ui:ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ui:ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><ProgressBar Grid.Column="1" Width="110" Height="4" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/></Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
