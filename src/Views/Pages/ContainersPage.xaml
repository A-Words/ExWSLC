<Page x:Class="ExWSLC.Views.Pages.ContainersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      x:Name="RootPage"
      Background="Transparent"
      Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <Style x:Key="WorkbenchPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{ui:ThemeResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ui:ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="MetricTileStyle" TargetType="Border" BasedOn="{StaticResource WorkbenchPanelStyle}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <DataTemplate x:Key="ContainerListItemTemplate">
            <Grid Margin="0" MinHeight="72">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{ui:ThemeResource TextFillColorTertiaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Background" Value="{ui:ThemeResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Image}" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0">
                    <TextBlock Text="{Binding State}" FontSize="12" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis" MaxWidth="82" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ContainerEmptyTemplate">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                <Border Width="92" Height="92" CornerRadius="22" Background="{ui:ThemeResource ControlFillColorTertiaryBrush}">
                    <ui:FontIcon FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xF5ED;" FontSize="44" Opacity=".42" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{DynamicResource NoContainerSelected}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,7" />
                <TextBlock Text="{DynamicResource SelectContainerHint}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                <ui:Button Content="{DynamicResource CreateContainer}" Icon="{ui:SymbolIcon Symbol=Add24}" Appearance="Primary" Command="{Binding DataContext.ShowCreateContainerCommand, ElementName=RootPage}" HorizontalAlignment="Center" Margin="0,18,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ContainerCreateTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Symbol=Dismiss24}" Appearance="Secondary" Command="{Binding DataContext.CancelCreateContainerCommand, ElementName=RootPage}" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="{DynamicResource CreateContainer}" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource CreateContainerHint}" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,18" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Image}" />
                                <ui:TextBox Text="{Binding DataContext.NewImage, ElementName=RootPage, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ubuntu:latest" Margin="0,5,0,12" />
                                <TextBlock Text="{DynamicResource Name}" />
                                <ui:TextBox Text="{Binding DataContext.NewContainerName, ElementName=RootPage, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="my-container" Margin="0,5,0,12" />
                                <TextBlock Text="{DynamicResource Command}" />
                                <ui:TextBox Text="{Binding DataContext.NewCommand, ElementName=RootPage, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional command" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="CPU" />
                                <ui:TextBox Text="{Binding DataContext.NewCpuLimit, ElementName=RootPage}" PlaceholderText="1.5" Margin="0,5,0,12" />
                                <TextBlock Text="Memory" />
                                <ui:TextBox Text="{Binding DataContext.NewMemoryLimit, ElementName=RootPage}" PlaceholderText="512M" Margin="0,5,0,12" />
                                <TextBlock Text="Network" />
                                <ui:TextBox Text="{Binding DataContext.NewNetwork, ElementName=RootPage}" PlaceholderText="bridge" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Advanced}" Style="{StaticResource SectionTitleStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0"><TextBlock Text="Environment" /><ui:TextBox Text="{Binding DataContext.NewEnvironment, ElementName=RootPage}" AcceptsReturn="True" Height="76" PlaceholderText="KEY=VALUE" /></StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Ports" /><ui:TextBox Text="{Binding DataContext.NewPorts, ElementName=RootPage}" AcceptsReturn="True" Height="76" PlaceholderText="8080:80" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Volumes" /><ui:TextBox Text="{Binding DataContext.NewVolumes, ElementName=RootPage}" AcceptsReturn="True" Height="76" PlaceholderText="source:/target" /></StackPanel>
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0"><TextBlock Text="User" /><ui:TextBox Text="{Binding DataContext.NewUser, ElementName=RootPage}" PlaceholderText="1000:1000" /></StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Workdir" /><ui:TextBox Text="{Binding DataContext.NewWorkingDirectory, ElementName=RootPage}" PlaceholderText="/app" /></StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom"><CheckBox Content="All GPUs" IsChecked="{Binding DataContext.NewUseAllGpus, ElementName=RootPage}" /><CheckBox Content="Remove when stopped" IsChecked="{Binding DataContext.NewRemoveWhenStopped, ElementName=RootPage}" Margin="0,8,0,0" /></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <ui:Button Content="{DynamicResource Run}" Icon="{ui:SymbolIcon Symbol=Play24}" Appearance="Primary" Command="{Binding DataContext.RunNewContainerCommand, ElementName=RootPage}" Padding="24,9" HorizontalAlignment="Right" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="ContainerDetailTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource WorkbenchPanelStyle}" Padding="22" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="78" Height="78" CornerRadius="16" Background="{ui:ThemeResource ControlFillColorTertiaryBrush}" Margin="0,0,20,0">
                            <ui:FontIcon FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xF5ED;" FontSize="40" Foreground="{ui:ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="28" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Width="8" Height="8" CornerRadius="4" Background="{ui:ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding State}" FontSize="14" />
                                <TextBlock Text="  |  " Opacity=".45" />
                                <TextBlock Text="{Binding Status}" FontSize="14" />
                                <TextBlock Text="  |  ID: " Opacity=".45" />
                                <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                            </StackPanel>
                        </StackPanel>
                        <WrapPanel Grid.Column="2" VerticalAlignment="Top">
                            <ui:Button Content="{DynamicResource Terminal}" Icon="{ui:SymbolIcon Symbol=WindowConsole20}" Appearance="Secondary" Command="{Binding DataContext.OpenTerminalCommand, ElementName=RootPage}" Margin="0,0,8,0" />
                            <ui:Button Content="{DynamicResource Logs}" Icon="{ui:SymbolIcon Symbol=DocumentText24}" Appearance="Secondary" Command="{Binding DataContext.ShowLogsCommand, ElementName=RootPage}" Margin="0,0,8,0" />
                            <ui:Button Content="{DynamicResource Exec}" Icon="{ui:SymbolIcon Symbol=ChevronRight24}" Appearance="Secondary" Command="{Binding DataContext.ExecCommand, ElementName=RootPage}" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource WorkbenchPanelStyle}" Padding="16,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Image}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding Image}" Margin="12,0,28,0" TextTrimming="CharacterEllipsis" MaxWidth="340" />
                            <TextBlock Text="{DynamicResource Ports}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding Ports, TargetNullValue=-}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1">
                            <ui:Button Content="{DynamicResource Start}" Icon="{ui:SymbolIcon Symbol=Play24}" Appearance="Primary" Command="{Binding DataContext.StartContainerCommand, ElementName=RootPage}" Margin="0,0,8,0" />
                            <ui:Button Content="{DynamicResource Stop}" Command="{Binding DataContext.StopContainerCommand, ElementName=RootPage}" Margin="0,0,8,0" />
                            <ui:Button Content="{DynamicResource Restart}" Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" Command="{Binding DataContext.RestartContainerCommand, ElementName=RootPage}" Margin="0,0,8,0" />
                            <ui:Button Content="{DynamicResource Remove}" Appearance="Danger" Command="{Binding DataContext.RemoveContainerCommand, ElementName=RootPage}" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <TabControl Grid.Row="2" Margin="0">
                    <TabItem Header="{DynamicResource OverviewTab}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Border Style="{StaticResource MetricTileStyle}">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CPU" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding DataContext.SelectedContainerStats.Cpu, ElementName=RootPage, TargetNullValue=--}" FontSize="22" Margin="0,4,0,0" /></StackPanel><ui:SymbolIcon Grid.Column="1" Symbol="Pulse24" FontSize="24" Foreground="{DynamicResource AccentFillColorDefaultBrush}" /></Grid>
                                    </Border>
                                    <Border Style="{StaticResource MetricTileStyle}">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Memory" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding DataContext.SelectedContainerStats.Memory, ElementName=RootPage, TargetNullValue=--}" FontSize="22" Margin="0,4,0,0" /></StackPanel><ui:SymbolIcon Grid.Column="1" Symbol="Database24" FontSize="24" Foreground="{DynamicResource AccentFillColorDefaultBrush}" /></Grid>
                                    </Border>
                                    <Border Style="{StaticResource MetricTileStyle}">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Network I/O" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding DataContext.SelectedContainerStats.NetworkIo, ElementName=RootPage, TargetNullValue=--}" FontSize="22" Margin="0,4,0,0" /></StackPanel><ui:SymbolIcon Grid.Column="1" Symbol="ArrowBidirectionalUpDown24" FontSize="24" Foreground="{DynamicResource AccentFillColorDefaultBrush}" /></Grid>
                                    </Border>
                                    <Border Style="{StaticResource MetricTileStyle}" Margin="0">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Block I/O" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding DataContext.SelectedContainerStats.BlockIo, ElementName=RootPage, TargetNullValue=--}" FontSize="22" Margin="0,4,0,0" /></StackPanel><ui:SymbolIcon Grid.Column="1" Symbol="Storage24" FontSize="24" Foreground="{DynamicResource AccentFillColorDefaultBrush}" /></Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Border Style="{StaticResource WorkbenchPanelStyle}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Configuration}" Style="{StaticResource SectionTitleStyle}" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                                <TextBlock Text="{DynamicResource Name}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                                <TextBlock Grid.Row="1" Text="{DynamicResource Image}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Image}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="2" Text="{DynamicResource Created}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Created}" Margin="0,8,0,0" />
                                                <TextBlock Grid.Row="3" Text="{DynamicResource State}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding State}" Margin="0,8,0,0" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource WorkbenchPanelStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Mounts}" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="{DynamicResource MountsHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Ports, StringFormat=Ports: {0}}" FontFamily="Consolas" Margin="0,12,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{DynamicResource Logs}">
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                            <WrapPanel Margin="0,0,0,10">
                                <ui:Button Content="{DynamicResource Refresh}" Command="{Binding DataContext.ShowLogsCommand, ElementName=RootPage}" Margin="0,0,8,0" />
                                <ui:Button Content="{DynamicResource FollowLogs}" Command="{Binding DataContext.FollowLogsCommand, ElementName=RootPage}" Margin="0,0,8,0" />
                                <ui:Button Content="{DynamicResource StopFollowing}" Command="{Binding DataContext.StopFollowingLogsCommand, ElementName=RootPage}" />
                            </WrapPanel>
                            <ui:TextBox Grid.Row="1" Text="{Binding DataContext.DetailOutput, ElementName=RootPage}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="{DynamicResource Exec}">
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,10">
                                <ui:Button DockPanel.Dock="Right" Content="{DynamicResource Exec}" Icon="{ui:SymbolIcon Symbol=ChevronRight24}" Appearance="Primary" Command="{Binding DataContext.ExecCommand, ElementName=RootPage}" Margin="8,0,0,0" />
                                <ui:TextBox Text="{Binding DataContext.ExecText, ElementName=RootPage, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                            </DockPanel>
                            <ui:TextBox Grid.Row="1" Text="{Binding DataContext.DetailOutput, ElementName=RootPage}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="{DynamicResource Inspect}">
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                            <WrapPanel Margin="0,0,0,10">
                                <ui:Button Content="{DynamicResource Inspect}" Appearance="Primary" Command="{Binding DataContext.InspectContainerCommand, ElementName=RootPage}" Margin="0,0,8,0" />
                                <ui:Button Content="{DynamicResource Export}" Command="{Binding DataContext.ExportContainerCommand, ElementName=RootPage}" />
                            </WrapPanel>
                            <ui:TextBox Grid.Row="1" Text="{Binding DataContext.DetailOutput, ElementName=RootPage}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="{DynamicResource Metrics}">
                        <Border Style="{StaticResource WorkbenchPanelStyle}" Margin="0,14,0,0" Padding="0">
                            <DataGrid ItemsSource="{Binding DataContext.Stats, ElementName=RootPage}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="110" />
                                    <DataGridTextColumn Header="Memory" Binding="{Binding Memory}" Width="170" />
                                    <DataGridTextColumn Header="Network I/O" Binding="{Binding NetworkIo}" Width="170" />
                                    <DataGridTextColumn Header="PIDs" Binding="{Binding Pids}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="318" MinWidth="260" MaxWidth="380" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource WorkbenchPanelStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Margin="18,18,18,12">
                    <TextBlock Text="{DynamicResource ContainersTitle}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource ContainersQuickHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="14,0,14,12">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ui:TextBox PlaceholderText="{DynamicResource Search}" ClearButtonEnabled="True" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Symbol=Add24}" Appearance="Secondary" Command="{Binding ShowCreateContainerCommand}" Width="36" Height="36" Margin="8,0,0,0" ToolTip="{DynamicResource CreateContainer}" />
                </Grid>
                <ui:ListView Grid.Row="2" ItemsSource="{Binding VisibleContainers}" SelectedItem="{Binding SelectedContainer}" ItemTemplate="{StaticResource ContainerListItemTemplate}" Margin="6,0,6,6" />
                <Grid Grid.Row="3" Margin="18,10,18,16">
                    <TextBlock Text="{Binding Containers.Count, StringFormat={}{0} containers}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                    <ui:Button Icon="{ui:SymbolIcon Symbol=ArrowSync24}" Appearance="Secondary" Command="{Binding RefreshAllCommand}" Width="34" Height="34" HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Border>
        <GridSplitter Grid.Column="1" Width="12" Background="Transparent" HorizontalAlignment="Stretch" />
        <Border Grid.Column="2" Style="{StaticResource WorkbenchPanelStyle}" Padding="0" ClipToBounds="True">
            <ContentControl Content="{Binding SelectedContainer}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource ContainerDetailTemplate}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedContainer}" Value="{x:Null}">
                                <Setter Property="ContentTemplate" Value="{StaticResource ContainerEmptyTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCreatingContainer}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource ContainerCreateTemplate}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Border>
    </Grid>
</Page>
