<Page x:Class="ExWSLC.Views.Pages.ContainersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      x:Name="RootPage" Background="Transparent">
    <Page.Resources>
        <DataTemplate x:Key="ContainerListItemTemplate">
            <Grid Margin="2,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Width="6" Height="6" CornerRadius="3" Margin="0,0,9,0" VerticalAlignment="Center">
                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{ui:ThemeResource TextFillColorTertiaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Background" Value="{ui:ThemeResource SystemFillColorSuccessBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                </Border>
                <ui:FontIcon Grid.Column="1" FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xF5ED;" FontSize="16" Margin="0,0,9,0"/>
                <StackPanel Grid.Column="2"><TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Image}" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis"/></StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ContainerEmptyTemplate">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340">
                <ui:FontIcon FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xF5ED;" FontSize="46" Opacity=".28" HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource NoContainerSelected}" FontSize="20" FontWeight="SemiBold" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,16,0,6"/>
                <TextBlock Text="{DynamicResource SelectContainerHint}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ContainerCreateTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <DockPanel><ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Symbol=Dismiss24}" Appearance="Secondary" Command="{Binding DataContext.CancelCreateContainerCommand, ElementName=RootPage}" VerticalAlignment="Top"/><StackPanel><TextBlock Text="{DynamicResource CreateContainer}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource CreateContainerHint}" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,18"/></StackPanel></DockPanel>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0"><TextBlock Text="{DynamicResource Image}"/><ui:TextBox Text="{Binding DataContext.NewImage, ElementName=RootPage, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ubuntu:latest" Margin="0,5,0,12"/><TextBlock Text="{DynamicResource Name}"/><ui:TextBox Text="{Binding DataContext.NewContainerName, ElementName=RootPage, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="my-container" Margin="0,5,0,12"/><TextBlock Text="{DynamicResource Command}"/><ui:TextBox Text="{Binding DataContext.NewCommand, ElementName=RootPage, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional command" Margin="0,5,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="CPU"/><ui:TextBox Text="{Binding DataContext.NewCpuLimit, ElementName=RootPage}" PlaceholderText="1.5" Margin="0,5,0,12"/><TextBlock Text="Memory"/><ui:TextBox Text="{Binding DataContext.NewMemoryLimit, ElementName=RootPage}" PlaceholderText="512M" Margin="0,5,0,12"/><TextBlock Text="Network"/><ui:TextBox Text="{Binding DataContext.NewNetwork, ElementName=RootPage}" PlaceholderText="bridge" Margin="0,5,0,0"/></StackPanel>
                    </Grid></Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"><StackPanel><TextBlock Text="{DynamicResource Advanced}" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="Environment"/><ui:TextBox Text="{Binding DataContext.NewEnvironment, ElementName=RootPage}" AcceptsReturn="True" Height="76" PlaceholderText="KEY=VALUE"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Ports"/><ui:TextBox Text="{Binding DataContext.NewPorts, ElementName=RootPage}" AcceptsReturn="True" Height="76" PlaceholderText="8080:80"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Volumes"/><ui:TextBox Text="{Binding DataContext.NewVolumes, ElementName=RootPage}" AcceptsReturn="True" Height="76" PlaceholderText="source:/target"/></StackPanel>
                        </Grid>
                        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="User"/><ui:TextBox Text="{Binding DataContext.NewUser, ElementName=RootPage}" PlaceholderText="1000:1000"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Workdir"/><ui:TextBox Text="{Binding DataContext.NewWorkingDirectory, ElementName=RootPage}" PlaceholderText="/app"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Bottom"><CheckBox Content="All GPUs" IsChecked="{Binding DataContext.NewUseAllGpus, ElementName=RootPage}"/><CheckBox Content="Remove when stopped" IsChecked="{Binding DataContext.NewRemoveWhenStopped, ElementName=RootPage}" Margin="0,8,0,0"/></StackPanel></Grid>
                    </StackPanel></Border>
                    <ui:Button Content="{DynamicResource Run}" Icon="{ui:SymbolIcon Symbol=Play24}" Appearance="Primary" Command="{Binding DataContext.RunNewContainerCommand, ElementName=RootPage}" Padding="24,9" HorizontalAlignment="Right"/>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="ContainerDetailTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <Border Style="{StaticResource CardStyle}" Padding="24" Margin="0,0,0,14">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="92" Height="92" CornerRadius="18" Background="{ui:ThemeResource ControlFillColorTertiaryBrush}" Margin="0,0,20,0"><ui:FontIcon FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xF5ED;" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="27" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Border Background="{ui:ThemeResource ControlFillColorTertiaryBrush}" CornerRadius="5" Padding="9,5" Margin="0,0,8,0"><TextBlock Text="{Binding State}"/></Border><Border Background="{ui:ThemeResource ControlFillColorTertiaryBrush}" CornerRadius="5" Padding="9,5" Margin="0,0,8,0"><TextBlock Text="{Binding Image}"/></Border><Border Background="{ui:ThemeResource ControlFillColorTertiaryBrush}" CornerRadius="5" Padding="9,5"><TextBlock Text="{Binding Ports, TargetNullValue=No published ports}"/></Border></StackPanel><TextBlock Text="{Binding Id}" Style="{StaticResource MutedTextStyle}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,9,20,0"/></StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"><ui:Button Content="{DynamicResource Terminal}" Appearance="Secondary" Command="{Binding DataContext.OpenTerminalCommand, ElementName=RootPage}" Margin="0,0,8,0"/><ui:Button Content="{DynamicResource Start}" Appearance="Primary" Command="{Binding DataContext.StartContainerCommand, ElementName=RootPage}"/></StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CompactCardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:FontIcon Glyph="&#xE945;" FontFamily="{DynamicResource SegoeFluentIcons}" FontSize="23" Margin="0,0,14,0"/><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource ContainerLifecycle}" FontSize="16"/><TextBlock Text="{DynamicResource ContainerLifecycleHint}" Style="{StaticResource MutedTextStyle}"/></StackPanel><WrapPanel Grid.Column="2" VerticalAlignment="Center"><ui:Button Content="{DynamicResource Stop}" Command="{Binding DataContext.StopContainerCommand, ElementName=RootPage}"/><ui:Button Content="{DynamicResource Restart}" Command="{Binding DataContext.RestartContainerCommand, ElementName=RootPage}"/><ui:Button Content="{DynamicResource Kill}" Command="{Binding DataContext.KillContainerCommand, ElementName=RootPage}"/><ui:Button Content="{DynamicResource Remove}" Appearance="Danger" Command="{Binding DataContext.RemoveContainerCommand, ElementName=RootPage}"/></WrapPanel></Grid></Border>

                    <Expander Margin="0,0,0,10"><Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><ui:FontIcon Glyph="&#xE9D9;" FontFamily="{DynamicResource SegoeFluentIcons}" FontSize="23" Margin="0,0,14,0"/><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource LiveStats}" FontSize="16"/><TextBlock Text="{DynamicResource LiveStatsHint}" Style="{StaticResource MutedTextStyle}"/></StackPanel></Grid></Expander.Header><Border Style="{StaticResource LayerCardStyle}" Margin="0,8,0,0"><DataGrid ItemsSource="{Binding DataContext.Stats, ElementName=RootPage}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="180"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="90"/><DataGridTextColumn Header="Memory" Binding="{Binding Memory}" Width="160"/><DataGridTextColumn Header="Network I/O" Binding="{Binding NetworkIo}" Width="150"/></DataGrid.Columns></DataGrid></Border></Expander>

                    <Expander Margin="0,0,0,10"><Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:FontIcon Glyph="&#xE8A5;" FontFamily="{DynamicResource SegoeFluentIcons}" FontSize="23" Margin="0,0,14,0"/><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Logs}" FontSize="16"/><TextBlock Text="{DynamicResource LogsHint}" Style="{StaticResource MutedTextStyle}"/></StackPanel><WrapPanel Grid.Column="2"><ui:Button Content="{DynamicResource Refresh}" Command="{Binding DataContext.ShowLogsCommand, ElementName=RootPage}"/><ui:Button Content="{DynamicResource FollowLogs}" Command="{Binding DataContext.FollowLogsCommand, ElementName=RootPage}"/><ui:Button Content="{DynamicResource StopFollowing}" Command="{Binding DataContext.StopFollowingLogsCommand, ElementName=RootPage}"/></WrapPanel></Grid></Expander.Header><ui:TextBox Text="{Binding DataContext.DetailOutput, ElementName=RootPage}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" MinHeight="210" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,8,0,0"/></Expander>

                    <Expander Margin="0,0,0,10"><Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:FontIcon Glyph="&#xE756;" FontFamily="{DynamicResource SegoeFluentIcons}" FontSize="23" Margin="0,0,14,0"/><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Exec}" FontSize="16"/><TextBlock Text="{DynamicResource ExecHint}" Style="{StaticResource MutedTextStyle}"/></StackPanel><ui:Button Grid.Column="2" Content="{DynamicResource Inspect}" Command="{Binding DataContext.InspectContainerCommand, ElementName=RootPage}"/></Grid></Expander.Header><DockPanel Margin="0,8,0,0"><ui:Button DockPanel.Dock="Right" Content="{DynamicResource Exec}" Appearance="Primary" Command="{Binding DataContext.ExecCommand, ElementName=RootPage}" Margin="8,0,0,0"/><ui:TextBox Text="{Binding DataContext.ExecText, ElementName=RootPage, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/></DockPanel></Expander>

                    <Border Style="{StaticResource CompactCardStyle}" Margin="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:FontIcon Glyph="&#xE7C3;" FontFamily="{DynamicResource SegoeFluentIcons}" FontSize="23" Margin="0,0,14,0"/><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Export}" FontSize="16"/><TextBlock Text="{DynamicResource ExportHint}" Style="{StaticResource MutedTextStyle}"/></StackPanel><ui:Button Grid.Column="2" Content="{DynamicResource Export}" Command="{Binding DataContext.ExportContainerCommand, ElementName=RootPage}" VerticalAlignment="Center"/></Grid></Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="244" MinWidth="190" MaxWidth="310"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource LayerCardStyle}" Margin="0" Padding="0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:TextBox PlaceholderText="{DynamicResource Search}" ClearButtonEnabled="True" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/><ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Symbol=Add24}" Appearance="Secondary" Command="{Binding ShowCreateContainerCommand}" Width="34" Height="34" Margin="8,0,0,0" ToolTip="{DynamicResource CreateContainer}"/></Grid>
                <ui:ListView Grid.Row="1" ItemsSource="{Binding VisibleContainers}" SelectedItem="{Binding SelectedContainer}" ItemTemplate="{StaticResource ContainerListItemTemplate}" Margin="4,0,4,4"/>
            </Grid>
        </Border>
        <GridSplitter Grid.Column="1" Width="12" Background="Transparent" HorizontalAlignment="Stretch"/>
        <Border Grid.Column="2" Style="{StaticResource LayerCardStyle}" Margin="0" Padding="0" ClipToBounds="True">
            <ContentControl Content="{Binding SelectedContainer}">
                <ContentControl.Style><Style TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{StaticResource ContainerDetailTemplate}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedContainer}" Value="{x:Null}"><Setter Property="ContentTemplate" Value="{StaticResource ContainerEmptyTemplate}"/></DataTrigger><DataTrigger Binding="{Binding IsCreatingContainer}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource ContainerCreateTemplate}"/></DataTrigger></Style.Triggers></Style></ContentControl.Style>
            </ContentControl>
        </Border>
    </Grid>
</Page>
