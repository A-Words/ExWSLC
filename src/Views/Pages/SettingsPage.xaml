<Page x:Class="ExWSLC.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:designViewModels="clr-namespace:ExWSLC.ViewModels.Design"
      xmlns:models="clr-namespace:ExWSLC.Models"
      x:Name="RootPage"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=designViewModels:DesignSettingsViewModel, IsDesignTimeCreatable=True}"
      Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <Style x:Key="CapabilityIconStyle"
               TargetType="ui:SymbolIcon">
            <Setter Property="Symbol" Value="QuestionCircle24" />
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="24" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:CapabilitySupport.Supported}">
                    <Setter Property="Symbol" Value="CheckmarkCircle24" />
                    <Setter Property="Foreground" Value="{ui:ThemeResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:CapabilitySupport.Unsupported}">
                    <Setter Property="Symbol" Value="DismissCircle24" />
                    <Setter Property="Foreground" Value="{ui:ThemeResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CapabilityStatusTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="Text" Value="{DynamicResource Unknown}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:CapabilitySupport.Supported}">
                    <Setter Property="Text" Value="{DynamicResource Ready}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:CapabilitySupport.Unsupported}">
                    <Setter Property="Text" Value="{DynamicResource Unavailable}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsFieldStyle" TargetType="StackPanel">
            <Setter Property="Width" Value="220" />
            <Setter Property="Margin" Value="0,0,16,12" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="SettingsScrollViewer"
                  Height="{Binding ActualHeight, ElementName=RootPage}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PreviewMouseWheel="SettingsScrollViewer_OnPreviewMouseWheel">
        <StackPanel Margin="24,18,24,28" MaxWidth="1180">
            <TextBlock Text="{DynamicResource SettingsTitle}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{DynamicResource SettingsSubtitle}" Style="{StaticResource PageSubtitleStyle}" />

            <DockPanel Margin="0,0,0,12">
                <ui:Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                           Content="{DynamicResource RefreshRuntimeEnvironment}"
                           Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}"
                           Command="{Binding RefreshCapabilitiesCommand}" />
                <TextBlock Text="{DynamicResource RuntimeEnvironment}" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
            </DockPanel>
            <ui:Card Padding="16,14" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Style="{StaticResource CapabilityIconStyle}" Tag="{Binding Capabilities.CliAvailability}" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="WSL Container CLI" FontSize="16" />
                        <TextBlock Text="{Binding CliVersionText}" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Style="{StaticResource CapabilityStatusTextStyle}" Tag="{Binding Capabilities.CliAvailability}" />
                </Grid>
            </ui:Card>

            <ui:Card Padding="16,14" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Style="{StaticResource CapabilityIconStyle}" Tag="{Binding Capabilities.ServiceAvailability}" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource RuntimeService}" FontSize="16" />
                        <TextBlock Text="{Binding ServiceVersionText}" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Style="{StaticResource CapabilityStatusTextStyle}" Tag="{Binding Capabilities.ServiceAvailability}" />
                </Grid>
            </ui:Card>

            <ui:Card Padding="16,14" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Style="{StaticResource CapabilityIconStyle}" Tag="{Binding Capabilities.SdkAvailability}" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Microsoft.WSL.Containers SDK" FontSize="16" />
                        <TextBlock Text="{DynamicResource BundledSdkPackage}" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Capabilities.SdkPackageVersion}" FontFamily="Consolas" HorizontalAlignment="Right" />
                        <TextBlock Style="{StaticResource CapabilityStatusTextStyle}" Tag="{Binding Capabilities.SdkAvailability}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <TextBlock Text="{Binding EnvironmentMessage}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8" />

            <ui:Card x:Name="DiagnosticsCard" Padding="16" Margin="0,8,0,18">
                <StackPanel>
                    <TextBlock Text="{DynamicResource DiagnosticsTitle}" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{DynamicResource DiagnosticsPrivacyHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <WrapPanel Margin="0,0,0,12">
                        <ui:Button Content="{DynamicResource DiagnosticsRefresh}" Command="{Binding RefreshDiagnosticsCommand}"
                                   Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" Margin="0,0,8,8" />
                        <ui:Button Content="{DynamicResource Cancel}" Command="{Binding Workspace.CancelCurrentOperationCommand}"
                                   IsEnabled="{Binding RefreshDiagnosticsCommand.IsRunning}" Margin="0,0,8,8" />
                        <ui:Button Content="{DynamicResource DiagnosticsCopy}" Command="{Binding CopyDiagnosticsCommand}" Margin="0,0,8,8" />
                        <ui:Button Content="{DynamicResource DiagnosticsExport}" Command="{Binding ExportDiagnosticsCommand}" Margin="0,0,0,8" />
                    </WrapPanel>
                    <TextBlock Text="{Binding DiagnosticsStatus}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding DiagnosticsActionStatus}" TextWrapping="Wrap" Margin="0,0,0,8"
                               AutomationProperties.LiveSetting="Polite" />
                    <ItemsControl ItemsSource="{Binding DiagnosticsFields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter"><Setter Property="Width" Value="300" /><Setter Property="Margin" Value="0,0,12,0" /></Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                    <TextBlock Text="{DynamicResource DiagnosticsSessions}" FontSize="16" Margin="0,12,0,8" />
                    <TextBlock Text="{Binding DiagnosticsSessionsStatus}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding DiagnosticsSessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <ui:Card x:Name="HostLoopbackCard" Padding="16" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="{DynamicResource HostLoopbackTitle}" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource HostLoopbackExplanation}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBlock Text="{DynamicResource HostLoopbackSessionUnknown}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <WrapPanel Margin="0,0,0,8">
                        <ui:Button Content="{DynamicResource HostConfigRead}" Command="{Binding ReadHostLoopbackCommand}" Margin="0,0,8,8" />
                        <StackPanel Margin="0,0,0,8" MaxWidth="420">
                            <TextBlock Text="{Binding HostLoopbackHost}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding HostLoopbackConfigStatus}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </WrapPanel>
                    <WrapPanel>
                        <StackPanel Style="{StaticResource SettingsFieldStyle}">
                            <TextBlock x:Name="HostProbeContainerLabel" Text="{DynamicResource HostProbeContainer}" />
                            <ComboBox ItemsSource="{Binding Workspace.ActiveContainers}" SelectedItem="{Binding HostProbeContainer}"
                                      DisplayMemberPath="Name" Margin="0,6,0,0" AutomationProperties.LabeledBy="{Binding ElementName=HostProbeContainerLabel}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource SettingsFieldStyle}">
                            <TextBlock x:Name="HostProbePortLabel" Text="{DynamicResource HostProbePort}" />
                            <ui:TextBox Text="{Binding HostProbePort, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" Margin="0,6,0,0"
                                        AutomationProperties.LabeledBy="{Binding ElementName=HostProbePortLabel}" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding HostProbeValidation}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource HostProbeLimits}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <WrapPanel>
                        <ui:Button Content="{DynamicResource HostProbeRun}" Command="{Binding ProbeHostLoopbackCommand}" Appearance="Primary" Margin="0,0,8,8" />
                        <ui:Button Content="{DynamicResource Cancel}" Command="{Binding Workspace.CancelCurrentOperationCommand}"
                                   IsEnabled="{Binding ProbeHostLoopbackCommand.IsRunning}" Margin="0,0,8,8" />
                        <ui:Button Content="{DynamicResource HostProbeCopy}" Command="{Binding CopyHostProbeCommand}" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock Text="{Binding HostProbeSummary}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding HostProbeCopyStatus}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <ui:CardAction Command="{Binding OpenNativeSettingsCommand}"
                           IsChevronVisible="True"
                           Margin="0,0,0,8"
                           AutomationProperties.Name="{DynamicResource NativeSettings}">
                <ui:CardAction.Icon>
                    <ui:SymbolIcon Symbol="Settings24" />
                </ui:CardAction.Icon>
                <StackPanel>
                    <TextBlock Text="{DynamicResource NativeSettings}" FontSize="16" />
                    <TextBlock Text="{DynamicResource NativeSettingsHint}" Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </ui:CardAction>

            <ui:Card Padding="16,12" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource RuntimeMaintenance}" FontSize="16" />
                        <TextBlock Text="{DynamicResource RuntimeMaintenanceHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:Button Grid.Column="1"
                               Content="{DynamicResource InstallComponents}"
                               Icon="{ui:SymbolIcon Symbol=Wrench24}"
                               Appearance="Secondary"
                               Command="{Binding InstallComponentsCommand}"
                               Margin="12,0,8,0" />
                    <ui:Button Grid.Column="2"
                               Content="{DynamicResource ResetNativeSettings}"
                               Icon="{ui:SymbolIcon Symbol=ArrowCounterclockwise24}"
                               Appearance="Danger"
                               Command="{Binding ResetNativeSettingsCommand}" />
                </Grid>
            </ui:Card>

            <TextBlock Text="{DynamicResource Appearance}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
            <ui:Card Padding="18" Margin="0,0,0,18">
                <StackPanel>
                    <WrapPanel>
                        <StackPanel Style="{StaticResource SettingsFieldStyle}">
                            <TextBlock x:Name="LanguageLabel" Text="{DynamicResource Language}" />
                            <ComboBox SelectedValue="{Binding SelectedLanguage}"
                                      SelectedValuePath="Tag"
                                      AutomationProperties.LabeledBy="{Binding ElementName=LanguageLabel}"
                                      Margin="0,6,0,0">
                                <ComboBoxItem Tag="zh-CN" Content="{DynamicResource LanguageChinese}" />
                                <ComboBoxItem Tag="en-US" Content="{DynamicResource LanguageEnglish}" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Style="{StaticResource SettingsFieldStyle}">
                            <TextBlock x:Name="ThemeLabel" Text="{DynamicResource Theme}" />
                            <ComboBox SelectedValue="{Binding SelectedTheme}"
                                      SelectedValuePath="Tag"
                                      AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}"
                                      Margin="0,6,0,0">
                                <ComboBoxItem Tag="System" Content="{DynamicResource ThemeSystem}" />
                                <ComboBoxItem Tag="Light" Content="{DynamicResource ThemeLight}" />
                                <ComboBoxItem Tag="Dark" Content="{DynamicResource ThemeDark}" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Style="{StaticResource SettingsFieldStyle}">
                            <TextBlock x:Name="RefreshIntervalLabel" Text="{DynamicResource RefreshInterval}" />
                            <ui:NumberBox Value="{Binding RefreshIntervalSeconds}"
                                          Minimum="2"
                                          Maximum="300"
                                          AutomationProperties.LabeledBy="{Binding ElementName=RefreshIntervalLabel}"
                                          Margin="0,6,0,0" />
                        </StackPanel>
                    </WrapPanel>
                    <ui:Button Content="{DynamicResource SaveSettings}"
                               Icon="{ui:SymbolIcon Symbol=Save24}"
                               Appearance="Primary"
                               Command="{Binding SaveSettingsCommand}"
                               HorizontalAlignment="Right"
                               Padding="18,8" />
                </StackPanel>
            </ui:Card>

            <TextBlock Text="{DynamicResource RegistryLogin}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" />
            <TextBlock Text="{DynamicResource RegistryCredentialsHint}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,12" TextWrapping="Wrap" />
            <ui:Card Padding="18">
                <StackPanel>
                    <WrapPanel>
                        <StackPanel Style="{StaticResource SettingsFieldStyle}">
                            <TextBlock x:Name="RegistryServerLabel" Text="{DynamicResource Server}" />
                            <ui:TextBox Text="{Binding RegistryServer, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.LabeledBy="{Binding ElementName=RegistryServerLabel}"
                                        Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource SettingsFieldStyle}">
                            <TextBlock x:Name="RegistryUsernameLabel" Text="{DynamicResource Username}" />
                            <ui:TextBox Text="{Binding RegistryUsername, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.LabeledBy="{Binding ElementName=RegistryUsernameLabel}"
                                        Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource SettingsFieldStyle}">
                            <TextBlock x:Name="RegistryPasswordLabel" Text="{DynamicResource Password}" />
                            <ui:PasswordBox PasswordChanged="RegistryPasswordBox_OnPasswordChanged"
                                            AutomationProperties.LabeledBy="{Binding ElementName=RegistryPasswordLabel}"
                                            Margin="0,6,0,0" />
                        </StackPanel>
                    </WrapPanel>
                    <ui:Button Content="{DynamicResource Login}"
                               Icon="{ui:SymbolIcon Symbol=Key24}"
                               Appearance="Primary"
                               Command="{Binding LoginRegistryCommand}"
                               HorizontalAlignment="Right"
                               Padding="18,8" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
