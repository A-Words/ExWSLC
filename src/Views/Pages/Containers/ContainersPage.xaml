<Page x:Class="ExWSLC.Views.Pages.Containers.ContainersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:containers="clr-namespace:ExWSLC.Views.Pages.Containers"
      x:Name="RootPage"
      Background="Transparent"
      Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <Style x:Key="WorkbenchPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{ui:ThemeResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ui:ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="MetricTileStyle" TargetType="Border" BasedOn="{StaticResource WorkbenchPanelStyle}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="DetailHeaderActionButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="8,0,0,8" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="DetailMetaItemStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,8,22,0" />
        </Style>

        <Style x:Key="DetailMetaLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <DataTemplate x:Key="ContainerListTemplate">
            <containers:ContainerListView />
        </DataTemplate>

        <DataTemplate x:Key="ContainerCreateTemplate">
            <containers:ContainerCreateView />
        </DataTemplate>

        <DataTemplate x:Key="ContainerDetailTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,12">
                    <ui:Button Content="{DynamicResource ContainersTitle}" Icon="{ui:SymbolIcon Symbol=ArrowLeft24}" Appearance="Secondary" Command="{Binding DataContext.ShowContainerListCommand, ElementName=RootPage}" />
                </DockPanel>

                <Border Grid.Row="1" Style="{StaticResource WorkbenchPanelStyle}" Padding="22,18" Margin="0,0,0,12" SizeChanged="ContainerDetailHeader_SizeChanged">
                    <Grid x:Name="DetailHeaderLayout">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="DetailHeaderInfo" VerticalAlignment="Center" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="9" Height="9" CornerRadius="4.5" VerticalAlignment="Center" Margin="0,2,10,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{ui:ThemeResource TextFillColorTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Background" Value="{ui:ThemeResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <WrapPanel Margin="19,2,0,0">
                                <StackPanel Style="{StaticResource DetailMetaItemStyle}">
                                    <TextBlock Text="ID" Style="{StaticResource DetailMetaLabelStyle}" />
                                    <TextBlock Text="{Binding ShortId}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource DetailMetaItemStyle}">
                                    <TextBlock Text="{DynamicResource Image}" Style="{StaticResource DetailMetaLabelStyle}" />
                                    <TextBlock Text="{Binding Image}" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource DetailMetaItemStyle}">
                                    <TextBlock Text="{DynamicResource Ports}" Style="{StaticResource DetailMetaLabelStyle}" />
                                    <TextBlock Text="{Binding DisplayPorts}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource DetailMetaItemStyle}">
                                    <TextBlock Text="{DynamicResource State}" Style="{StaticResource DetailMetaLabelStyle}" />
                                    <TextBlock Text="{Binding State}" />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                        <WrapPanel x:Name="DetailHeaderActions" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <ui:Button Content="{DynamicResource Start}" Icon="{ui:SymbolIcon Symbol=Play24}" Appearance="Primary" Command="{Binding DataContext.StartContainerCommand, ElementName=RootPage}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource DetailHeaderActionButtonStyle}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button Content="{DynamicResource Stop}" Appearance="Secondary" Command="{Binding DataContext.StopContainerCommand, ElementName=RootPage}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Stop24" Filled="True" />
                                </ui:Button.Icon>
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource DetailHeaderActionButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button Content="{DynamicResource Restart}" Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" Appearance="Secondary" Command="{Binding DataContext.RestartContainerCommand, ElementName=RootPage}" Style="{StaticResource DetailHeaderActionButtonStyle}" />
                            <ui:Button Content="{DynamicResource Terminal}" Icon="{ui:SymbolIcon Symbol=WindowConsole20}" Appearance="Secondary" Command="{Binding DataContext.OpenTerminalCommand, ElementName=RootPage}" Style="{StaticResource DetailHeaderActionButtonStyle}" />
                            <ui:Button Content="{DynamicResource Remove}" Icon="{ui:SymbolIcon Symbol=Delete24}" Appearance="Danger" Command="{Binding DataContext.RemoveContainerCommand, ElementName=RootPage}" Style="{StaticResource DetailHeaderActionButtonStyle}" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <TabControl Grid.Row="2" Margin="0">
                    <TabItem Header="{DynamicResource OverviewTab}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Border Style="{StaticResource MetricTileStyle}">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Cpu}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding DataContext.SelectedContainerStats.Cpu, ElementName=RootPage, TargetNullValue=--}" FontSize="22" Margin="0,4,0,0" /></StackPanel><ui:SymbolIcon Grid.Column="1" Symbol="Pulse24" FontSize="24" Foreground="{DynamicResource AccentFillColorDefaultBrush}" /></Grid>
                                    </Border>
                                    <Border Style="{StaticResource MetricTileStyle}">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Memory}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding DataContext.SelectedContainerStats.Memory, ElementName=RootPage, TargetNullValue=--}" FontSize="22" Margin="0,4,0,0" /></StackPanel><ui:SymbolIcon Grid.Column="1" Symbol="Database24" FontSize="24" Foreground="{DynamicResource AccentFillColorDefaultBrush}" /></Grid>
                                    </Border>
                                    <Border Style="{StaticResource MetricTileStyle}">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource NetworkIo}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding DataContext.SelectedContainerStats.NetworkIo, ElementName=RootPage, TargetNullValue=--}" FontSize="22" Margin="0,4,0,0" /></StackPanel><ui:SymbolIcon Grid.Column="1" Symbol="ArrowBidirectionalUpDown24" FontSize="24" Foreground="{DynamicResource AccentFillColorDefaultBrush}" /></Grid>
                                    </Border>
                                    <Border Style="{StaticResource MetricTileStyle}" Margin="0">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource BlockIo}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding DataContext.SelectedContainerStats.BlockIo, ElementName=RootPage, TargetNullValue=--}" FontSize="22" Margin="0,4,0,0" /></StackPanel><ui:SymbolIcon Grid.Column="1" Symbol="Storage24" FontSize="24" Foreground="{DynamicResource AccentFillColorDefaultBrush}" /></Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Border Style="{StaticResource WorkbenchPanelStyle}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Configuration}" Style="{StaticResource SectionTitleStyle}" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                                <TextBlock Text="{DynamicResource Name}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                                <TextBlock Grid.Row="1" Text="{DynamicResource Image}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Image}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="2" Text="{DynamicResource Created}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Created}" Margin="0,8,0,0" />
                                                <TextBlock Grid.Row="3" Text="{DynamicResource State}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding State}" Margin="0,8,0,0" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource WorkbenchPanelStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Mounts}" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="{DynamicResource MountsHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <TextBlock Text="{DynamicResource Ports}" FontFamily="Consolas" />
                                                <TextBlock Text=": " FontFamily="Consolas" />
                                                <TextBlock Text="{Binding Ports}" FontFamily="Consolas" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{DynamicResource Logs}">
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                            <WrapPanel Margin="0,0,0,10">
                                <ui:Button Content="{DynamicResource Refresh}" Command="{Binding DataContext.ShowLogsCommand, ElementName=RootPage}" Margin="0,0,8,0" />
                                <ui:Button Content="{DynamicResource FollowLogs}" Command="{Binding DataContext.FollowLogsCommand, ElementName=RootPage}" Margin="0,0,8,0" />
                                <ui:Button Content="{DynamicResource StopFollowing}" Command="{Binding DataContext.StopFollowingLogsCommand, ElementName=RootPage}" />
                            </WrapPanel>
                            <ui:TextBox Grid.Row="1" Text="{Binding DataContext.DetailOutput, ElementName=RootPage}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="{DynamicResource Exec}">
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,10">
                                <ui:Button DockPanel.Dock="Right" Content="{DynamicResource Exec}" Icon="{ui:SymbolIcon Symbol=ChevronRight24}" Appearance="Primary" Command="{Binding DataContext.ExecCommand, ElementName=RootPage}" Margin="8,0,0,0" />
                                <ui:TextBox Text="{Binding DataContext.ExecText, ElementName=RootPage, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                            </DockPanel>
                            <ui:TextBox Grid.Row="1" Text="{Binding DataContext.DetailOutput, ElementName=RootPage}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="{DynamicResource Inspect}">
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                            <WrapPanel Margin="0,0,0,10">
                                <ui:Button Content="{DynamicResource Inspect}" Appearance="Primary" Command="{Binding DataContext.InspectContainerCommand, ElementName=RootPage}" Margin="0,0,8,0" />
                                <ui:Button Content="{DynamicResource Export}" Command="{Binding DataContext.ExportContainerCommand, ElementName=RootPage}" />
                            </WrapPanel>
                            <ui:TextBox Grid.Row="1" Text="{Binding DataContext.DetailOutput, ElementName=RootPage}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="{DynamicResource Metrics}">
                        <Border Style="{StaticResource WorkbenchPanelStyle}" Margin="0,14,0,0" Padding="0">
                            <DataGrid ItemsSource="{Binding DataContext.Stats, ElementName=RootPage}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource Name}" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="{DynamicResource Cpu}" Binding="{Binding Cpu}" Width="110" />
                                    <DataGridTextColumn Header="{DynamicResource Memory}" Binding="{Binding Memory}" Width="170" />
                                    <DataGridTextColumn Header="{DynamicResource NetworkIo}" Binding="{Binding NetworkIo}" Width="170" />
                                    <DataGridTextColumn Header="{DynamicResource Pids}" Binding="{Binding Pids}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="12">
        <ContentControl Content="{Binding SelectedContainer}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{StaticResource ContainerDetailTemplate}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedContainer}" Value="{x:Null}">
                            <Setter Property="ContentTemplate" Value="{StaticResource ContainerListTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCreatingContainer}" Value="True">
                            <Setter Property="ContentTemplate" Value="{StaticResource ContainerCreateTemplate}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
</Page>
