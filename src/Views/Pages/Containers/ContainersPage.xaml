<Page x:Class="ExWSLC.Views.Pages.Containers.ContainersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:containers="clr-namespace:ExWSLC.Views.Pages.Containers"
      xmlns:designViewModels="clr-namespace:ExWSLC.ViewModels.Design"
      x:Name="RootPage"
      mc:Ignorable="d"
      ScrollViewer.CanContentScroll="False"
      d:DataContext="{d:DesignInstance Type=designViewModels:DesignContainersViewModel, IsDesignTimeCreatable=True}"
      Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <DataTemplate x:Key="ContainerListTemplate">
            <containers:ContainerListView DataContext="{Binding DataContext, ElementName=RootPage}" />
        </DataTemplate>

        <DataTemplate x:Key="ContainerCreateTemplate">
            <containers:ContainerCreateView DataContext="{Binding DataContext, ElementName=RootPage}" />
        </DataTemplate>

        <DataTemplate x:Key="ContainerDetailTemplate">
            <containers:ContainerDetailView DataContext="{Binding DataContext, ElementName=RootPage}" />
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ContentControl Content="{Binding SelectedContainer}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{StaticResource ContainerDetailTemplate}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedContainer}" Value="{x:Null}">
                            <Setter Property="ContentTemplate" Value="{StaticResource ContainerListTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCreatingContainer}" Value="True">
                            <Setter Property="ContentTemplate" Value="{StaticResource ContainerCreateTemplate}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
</Page>
