<UserControl x:Class="ExWSLC.Views.Pages.Containers.ContainerDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:ExWSLC.Controls"
             xmlns:behaviors="clr-namespace:ExWSLC.Behaviors"
             xmlns:designViewModels="clr-namespace:ExWSLC.ViewModels.Design"
             xmlns:models="clr-namespace:ExWSLC.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=designViewModels:DesignContainersViewModel, IsDesignTimeCreatable=True}"
             Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <Style x:Key="WorkbenchPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{ui:ThemeResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ui:ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="MetricTileStyle" TargetType="Border" BasedOn="{StaticResource WorkbenchPanelStyle}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="DetailHeaderActionButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="8,0,0,8" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="DetailMetaItemStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,8,22,0" />
        </Style>

        <Style x:Key="DetailMetaLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="NetworkDetailLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="NetworkIconButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <Style x:Key="MountCardStyle" TargetType="Border" BasedOn="{StaticResource WorkbenchPanelStyle}">
            <Setter Property="Background" Value="{ui:ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="MountBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{ui:ThemeResource ControlFillColorTertiaryBrush}" />
            <Setter Property="BorderBrush" Value="{ui:ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MountBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="MountDetailLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Width" Value="96" />
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MountAccessTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MountBadgeTextStyle}">
            <Setter Property="Text" Value="{DynamicResource Unavailable}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Access}" Value="{x:Static models:ContainerMountAccess.ReadWrite}">
                    <Setter Property="Text" Value="{DynamicResource ReadWrite}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Access}" Value="{x:Static models:ContainerMountAccess.ReadOnly}">
                    <Setter Property="Text" Value="{DynamicResource ReadOnly}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MountIconButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource NetworkIconButtonStyle}" />

        <Style x:Key="NetworkPortExposureTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Text" Value="{DynamicResource DefaultBinding}" />
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Exposure}" Value="{x:Static models:ContainerPortExposure.LocalOnly}">
                    <Setter Property="Text" Value="{DynamicResource LocalOnly}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Exposure}" Value="{x:Static models:ContainerPortExposure.PotentiallyExposed}">
                    <Setter Property="Text" Value="{DynamicResource PotentiallyExposed}" />
                    <Setter Property="Foreground" Value="{ui:ThemeResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- WPF-UI's default TextBox content-host style swaps in a template with no ScrollBar
             elements, so output boxes never show scrollbars. Override it locally (DynamicResource
             resolves to the nearest scope) with the standard ScrollViewer template so the read-only
             log/inspect boxes show scrollbars on overflow. Visibility stays driven by the TextBox's
             own ScrollViewer.VerticalScrollBarVisibility/HorizontalScrollBarVisibility (set to Auto). -->
        <Style x:Key="DefaultTextBoxScrollViewerStyle" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}" />

        <DataTemplate x:Key="LogsDetailTemplate">
            <Grid Margin="0,14,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,10">
                    <ui:Button Content="{DynamicResource CopyLogs}" Command="{Binding CopyLogsCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="{DynamicResource ClearLogs}" Command="{Binding ClearLogsCommand}" />
                </WrapPanel>
                <Border Grid.Row="1" Style="{StaticResource WorkbenchPanelStyle}" Padding="4,2">
                    <ListBox ItemsSource="{Binding LogLines}"
                             Background="Transparent"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="13"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             behaviors:ListBoxAutoScrollBehavior.IsEnabled="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="6,0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" FontFamily="Consolas" TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ResourceUsageDetailTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource MetricTileStyle}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Cpu}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding SelectedContainerStats.Cpu, TargetNullValue=--}" FontSize="22" Margin="0,4,0,0" /></StackPanel><ui:SymbolIcon Grid.Column="1" Symbol="Pulse24" FontSize="24" Foreground="{DynamicResource AccentFillColorDefaultBrush}" /></Grid>
                        </Border>
                        <Border Style="{StaticResource MetricTileStyle}" Margin="0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource NetworkIo}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding SelectedContainerStats.NetworkIo, TargetNullValue=--}" FontSize="22" Margin="0,4,0,0" /></StackPanel><ui:SymbolIcon Grid.Column="1" Symbol="ArrowBidirectionalUpDown24" FontSize="24" Foreground="{DynamicResource AccentFillColorDefaultBrush}" /></Grid>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource MetricTileStyle}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Memory}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding SelectedContainerStats.Memory, TargetNullValue=--}" FontSize="22" Margin="0,4,0,0" /></StackPanel><ui:SymbolIcon Grid.Column="1" Symbol="Database24" FontSize="24" Foreground="{DynamicResource AccentFillColorDefaultBrush}" /></Grid>
                        </Border>
                        <Border Style="{StaticResource MetricTileStyle}" Margin="0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource BlockIo}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding SelectedContainerStats.BlockIo, TargetNullValue=--}" FontSize="22" Margin="0,4,0,0" /></StackPanel><ui:SymbolIcon Grid.Column="1" Symbol="Storage24" FontSize="24" Foreground="{DynamicResource AccentFillColorDefaultBrush}" /></Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="NetworkDetailTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,14,16,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,20"
                                Visibility="{Binding IsNetworkDetailsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:ProgressRing Width="22" Height="22" IsIndeterminate="True" Margin="0,0,10,0" />
                        <TextBlock Text="{DynamicResource LoadingNetworkDetails}" VerticalAlignment="Center" />
                    </StackPanel>

                    <ui:InfoBar IsOpen="{Binding HasNetworkDetailsError}"
                                IsClosable="False"
                                Severity="Error"
                                Title="{DynamicResource NetworkDetailsUnavailable}"
                                Message="{Binding NetworkDetailsError}"
                                Margin="0,0,0,12" />

                    <ui:InfoBar IsOpen="{Binding NetworkDetails.RuntimeAddressesUnavailable}"
                                IsClosable="False"
                                Severity="Informational"
                                Message="{DynamicResource RuntimeAddressesUnavailable}"
                                Margin="0,0,0,12" />

                    <StackPanel Visibility="{Binding HasNetworkDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Style="{StaticResource WorkbenchPanelStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource NetworkDetailsTitle}" Style="{StaticResource SectionTitleStyle}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource NetworkMode}" Style="{StaticResource NetworkDetailLabelStyle}" />
                                    <TextBlock Grid.Column="1" Text="{Binding NetworkDetails.DisplayNetworkMode}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="1" Text="{DynamicResource ContainerHostName}" Style="{StaticResource NetworkDetailLabelStyle}" Margin="0,10,12,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NetworkDetails.DisplayHostName}" TextTrimming="CharacterEllipsis" Margin="0,10,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource WorkbenchPanelStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ConnectedNetworks}" Style="{StaticResource SectionTitleStyle}" />
                                <ItemsControl ItemsSource="{Binding NetworkDetails.Networks}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="0,14,0,14">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <ui:SymbolIcon Symbol="PlugConnected24" FontSize="20" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,10,0" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Name}" FontSize="16" />
                                                            <TextBlock Text="{Binding DisplayAliases}" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <ui:Button Grid.Column="2"
                                                                   Icon="{ui:SymbolIcon Symbol=Copy20}"
                                                                   Command="{Binding DataContext.CopyNetworkValueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   CommandParameter="{Binding Name}"
                                                                   ToolTip="{DynamicResource Copy}"
                                                                   Style="{StaticResource NetworkIconButtonStyle}" />
                                                    </Grid>
                                                    <Grid Margin="0,14,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                                        <TextBlock Text="{DynamicResource IpAddress}" Style="{StaticResource NetworkDetailLabelStyle}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayIpAddress}" TextTrimming="CharacterEllipsis" />
                                                        <ui:Button Grid.Column="2"
                                                                   Icon="{ui:SymbolIcon Symbol=Copy20}"
                                                                   Command="{Binding DataContext.CopyNetworkValueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   CommandParameter="{Binding IpAddress}"
                                                                   IsEnabled="{Binding HasIpAddress}"
                                                                   ToolTip="{DynamicResource Copy}"
                                                                   Style="{StaticResource NetworkIconButtonStyle}" />
                                                        <TextBlock Grid.Row="1" Text="{DynamicResource Gateway}" Style="{StaticResource NetworkDetailLabelStyle}" Margin="0,10,12,0" />
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DisplayGateway}" TextTrimming="CharacterEllipsis" Margin="0,10,0,0" />
                                                    </Grid>
                                                    <ui:CardExpander Header="{DynamicResource InterfaceDetails}"
                                                                     Icon="{ui:SymbolIcon Symbol=NetworkAdapter16}"
                                                                     ContentPadding="16,0,16,12"
                                                                     Margin="0,14,0,0">
                                                        <Grid Margin="0,12,0,0">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                                            <TextBlock Text="{DynamicResource MacAddress}" Style="{StaticResource NetworkDetailLabelStyle}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayMacAddress}" TextTrimming="CharacterEllipsis" />
                                                            <ui:Button Grid.Column="2"
                                                                       Icon="{ui:SymbolIcon Symbol=Copy20}"
                                                                       Command="{Binding DataContext.CopyNetworkValueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       CommandParameter="{Binding MacAddress}"
                                                                       IsEnabled="{Binding HasMacAddress}"
                                                                       ToolTip="{DynamicResource Copy}"
                                                                       Style="{StaticResource NetworkIconButtonStyle}" />
                                                            <TextBlock Grid.Row="1" Text="{DynamicResource NetworkId}" Style="{StaticResource NetworkDetailLabelStyle}" Margin="0,10,12,0" />
                                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DisplayNetworkId}" TextTrimming="CharacterEllipsis" Margin="0,10,0,0" />
                                                            <ui:Button Grid.Row="1" Grid.Column="2"
                                                                       Icon="{ui:SymbolIcon Symbol=Copy20}"
                                                                       Command="{Binding DataContext.CopyNetworkValueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       CommandParameter="{Binding NetworkId}"
                                                                       IsEnabled="{Binding HasNetworkId}"
                                                                       ToolTip="{DynamicResource Copy}"
                                                                       Style="{StaticResource NetworkIconButtonStyle}" />
                                                            <TextBlock Grid.Row="2" Text="{DynamicResource EndpointId}" Style="{StaticResource NetworkDetailLabelStyle}" Margin="0,10,12,0" />
                                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DisplayEndpointId}" TextTrimming="CharacterEllipsis" Margin="0,10,0,0" />
                                                            <ui:Button Grid.Row="2" Grid.Column="2"
                                                                       Icon="{ui:SymbolIcon Symbol=Copy20}"
                                                                       Command="{Binding DataContext.CopyNetworkValueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       CommandParameter="{Binding EndpointId}"
                                                                       IsEnabled="{Binding HasEndpointId}"
                                                                       ToolTip="{DynamicResource Copy}"
                                                                       Style="{StaticResource NetworkIconButtonStyle}" />
                                                            <TextBlock Grid.Row="3" Text="{DynamicResource Aliases}" Style="{StaticResource NetworkDetailLabelStyle}" Margin="0,10,12,0" />
                                                            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding DisplayAliases}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                                        </Grid>
                                                    </ui:CardExpander>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{DynamicResource NoNetworkAttachments}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NetworkDetails.HasNetworks}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource WorkbenchPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource PortMappings}" Style="{StaticResource SectionTitleStyle}" />
                                <ItemsControl ItemsSource="{Binding NetworkDetails.PortBindings}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="PlugConnected24" FontSize="20" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,1,10,0" />
                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayHostEndpoint}" FontSize="15" VerticalAlignment="Center" />
                                                        <ui:SymbolIcon Symbol="ArrowRight24" FontSize="16" Margin="10,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding DisplayContainerEndpoint}" FontSize="15" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding Protocol}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text=" · " Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Style="{StaticResource NetworkPortExposureTextStyle}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <ui:Button Grid.Column="2"
                                                           Icon="{ui:SymbolIcon Symbol=Copy20}"
                                                           Command="{Binding DataContext.CopyNetworkValueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding DisplayHostEndpoint}"
                                                           IsEnabled="{Binding HasHostBinding}"
                                                           ToolTip="{DynamicResource Copy}"
                                                           Style="{StaticResource NetworkIconButtonStyle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{DynamicResource NoPublishedPorts}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NetworkDetails.HasPortBindings}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="MountsDetailTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="0,14,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,18"
                                    Visibility="{Binding IsMountDetailsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:ProgressRing Width="22" Height="22" IsIndeterminate="True" Margin="0,0,10,0" />
                            <TextBlock Text="{DynamicResource LoadingMountDetails}" VerticalAlignment="Center" />
                        </StackPanel>

                        <ui:InfoBar Grid.Row="1"
                                    IsOpen="{Binding HasMountDetailsError}"
                                    IsClosable="False"
                                    Severity="Error"
                                    Title="{DynamicResource MountDetailsUnavailable}"
                                    Message="{Binding MountDetailsError}"
                                    Margin="0,0,0,12" />

                        <ItemsControl Grid.Row="2"
                                      ItemsSource="{Binding MountDetails.Mounts}"
                                      Visibility="{Binding MountDetails.HasMounts, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MountCardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="32"
                                                        Height="32"
                                                        CornerRadius="6"
                                                        Background="{ui:ThemeResource ControlFillColorTertiaryBrush}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <ui:SymbolIcon FontSize="18"
                                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Symbol" Value="FolderLink24" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ContainerMountKind.Tmpfs}">
                                                                        <Setter Property="Symbol" Value="Storage24" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ContainerMountKind.Volume}">
                                                                        <Setter Property="Symbol" Value="HardDrive24" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                </Border>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayDestination}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0,14,0"
                                                           ToolTip="{Binding DisplayDestination}" />

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Style="{StaticResource MountBadgeStyle}" ToolTip="{DynamicResource MountType}">
                                                        <TextBlock Text="{Binding Type}" Style="{StaticResource MountBadgeTextStyle}" />
                                                    </Border>
                                                    <Border Style="{StaticResource MountBadgeStyle}" ToolTip="{DynamicResource AccessMode}">
                                                        <TextBlock Style="{StaticResource MountAccessTextStyle}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Grid.Row="1" Margin="46,12,0,0">
                                                <Grid Visibility="{Binding HasSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{DynamicResource SourcePath}" Style="{StaticResource MountDetailLabelStyle}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DisplaySource}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               ToolTip="{Binding DisplaySource}" />
                                                    <ui:Button Grid.Column="2"
                                                               Icon="{ui:SymbolIcon Symbol=Copy20}"
                                                               Command="{Binding DataContext.CopyMountValueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding Source}"
                                                               IsEnabled="{Binding HasSource}"
                                                               AutomationProperties.Name="{DynamicResource CopySourcePath}"
                                                               ToolTip="{DynamicResource Copy}"
                                                               Style="{StaticResource MountIconButtonStyle}" />
                                                </Grid>

                                                <Grid Margin="0,8,0,0"
                                                      Visibility="{Binding HasDestination, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{DynamicResource ContainerPath}" Style="{StaticResource MountDetailLabelStyle}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DisplayDestination}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               ToolTip="{Binding DisplayDestination}" />
                                                    <ui:Button Grid.Column="2"
                                                               Icon="{ui:SymbolIcon Symbol=Copy20}"
                                                               Command="{Binding DataContext.CopyMountValueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding Destination}"
                                                               IsEnabled="{Binding HasDestination}"
                                                               AutomationProperties.Name="{DynamicResource CopyContainerPath}"
                                                               ToolTip="{DynamicResource Copy}"
                                                               Style="{StaticResource MountIconButtonStyle}" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Grid.Row="2"
                                Background="{ui:ThemeResource ControlFillColorTertiaryBrush}"
                                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="24,26">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasMountDetails}" Value="True" />
                                                <Condition Binding="{Binding MountDetails.HasMounts}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                                <ui:SymbolIcon Symbol="FolderOpen24"
                                               FontSize="30"
                                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,10" />
                                <TextBlock Text="{DynamicResource NoMountsDiscovered}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource NoMountsDiscoveredHint}"
                                           Style="{StaticResource MutedTextStyle}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                </Grid>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="ConfigurationDetailTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource WorkbenchPanelStyle}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Configuration}" Style="{StaticResource SectionTitleStyle}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="ID" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedContainer.Id}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Text="{DynamicResource Name}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedContainer.Name}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="2" Text="{DynamicResource Image}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedContainer.Image}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="3" Text="{DynamicResource Created}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedContainer.Created}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="4" Text="{DynamicResource State}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedContainer.State}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="5" Text="{DynamicResource Command}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{DynamicResource Unavailable}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="6" Text="{DynamicResource EnvironmentVariables}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{DynamicResource Unavailable}" Margin="0,8,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="InspectDetailTemplate">
            <Grid Margin="0,14,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,10">
                    <ui:Button Content="{DynamicResource Inspect}" Appearance="Primary" Command="{Binding InspectContainerCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="{DynamicResource Export}" Command="{Binding ExportContainerCommand}" />
                </WrapPanel>
                <ui:TextBox Grid.Row="1" Text="{Binding DetailOutput}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <ui:Button Content="{DynamicResource ContainersTitle}" Icon="{ui:SymbolIcon Symbol=ArrowLeft24}" Appearance="Secondary" Command="{Binding ShowContainerListCommand}" />
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource WorkbenchPanelStyle}" Padding="22,18" Margin="0,0,0,12" SizeChanged="ContainerDetailHeader_SizeChanged">
            <Grid x:Name="DetailHeaderLayout">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="DetailHeaderInfo" VerticalAlignment="Center" Margin="0,0,20,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="9" Height="9" CornerRadius="4.5" VerticalAlignment="Center" Margin="0,2,10,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{ui:ThemeResource TextFillColorTertiaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedContainer.IsRunning}" Value="True">
                                            <Setter Property="Background" Value="{ui:ThemeResource SystemFillColorSuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="{Binding SelectedContainer.Name}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <WrapPanel Margin="19,2,0,0">
                        <StackPanel Style="{StaticResource DetailMetaItemStyle}">
                            <TextBlock Text="ID" Style="{StaticResource DetailMetaLabelStyle}" />
                            <TextBlock Text="{Binding SelectedContainer.ShortId}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource DetailMetaItemStyle}">
                            <TextBlock Text="{DynamicResource Image}" Style="{StaticResource DetailMetaLabelStyle}" />
                            <TextBlock Text="{Binding SelectedContainer.Image}" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource DetailMetaItemStyle}">
                            <TextBlock Text="{DynamicResource Ports}" Style="{StaticResource DetailMetaLabelStyle}" />
                            <TextBlock Text="{Binding SelectedContainer.DisplayPorts}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource DetailMetaItemStyle}">
                            <TextBlock Text="{DynamicResource State}" Style="{StaticResource DetailMetaLabelStyle}" />
                            <TextBlock Text="{Binding SelectedContainer.State}" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
                <WrapPanel x:Name="DetailHeaderActions" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <ui:Button Content="{DynamicResource Start}" Icon="{ui:SymbolIcon Symbol=Play24}" Appearance="Primary" Command="{Binding StartContainerCommand}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource DetailHeaderActionButtonStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedContainer.IsRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                    <ui:Button Content="{DynamicResource Stop}" Appearance="Secondary" Command="{Binding StopContainerCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Stop24" Filled="True" />
                        </ui:Button.Icon>
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource DetailHeaderActionButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedContainer.IsRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                    <ui:Button Content="{DynamicResource Restart}" Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" Appearance="Secondary" Command="{Binding RestartContainerCommand}" Style="{StaticResource DetailHeaderActionButtonStyle}" />
                    <ui:Button Content="{DynamicResource Terminal}" Icon="{ui:SymbolIcon Symbol=WindowConsole20}" Appearance="Secondary" Command="{Binding OpenTerminalCommand}" Style="{StaticResource DetailHeaderActionButtonStyle}" />
                    <ui:Button Content="{DynamicResource Remove}" Icon="{ui:SymbolIcon Symbol=Delete24}" Appearance="Danger" Command="{Binding RemoveContainerCommand}" Style="{StaticResource DetailHeaderActionButtonStyle}" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:SelectorBar x:Name="DetailSelector" SelectedIndex="{Binding SelectedDetailTabIndex, Mode=TwoWay}">
                <controls:SelectorBarItem Text="{DynamicResource Logs}" Tag="{StaticResource LogsDetailTemplate}" />
                <controls:SelectorBarItem Text="{DynamicResource ResourceUsage}" Tag="{StaticResource ResourceUsageDetailTemplate}" />
                <controls:SelectorBarItem Text="{DynamicResource Network}" Tag="{StaticResource NetworkDetailTemplate}" />
                <controls:SelectorBarItem Text="{DynamicResource Mounts}" Tag="{StaticResource MountsDetailTemplate}" />
                <controls:SelectorBarItem Text="{DynamicResource Configuration}" Tag="{StaticResource ConfigurationDetailTemplate}" />
                <controls:SelectorBarItem Text="{DynamicResource Inspect}" Tag="{StaticResource InspectDetailTemplate}" />
            </controls:SelectorBar>

            <ContentControl Grid.Row="1"
                            Content="{Binding}"
                            ContentTemplate="{Binding SelectedItem.Tag, ElementName=DetailSelector}" />
        </Grid>
    </Grid>
</UserControl>
