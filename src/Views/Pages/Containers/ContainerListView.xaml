<UserControl x:Class="ExWSLC.Views.Pages.Containers.ContainerListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:ExWSLC.Controls"
             xmlns:designViewModels="clr-namespace:ExWSLC.ViewModels.Design"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=designViewModels:DesignContainersViewModel, IsDesignTimeCreatable=True}"
             Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ContainerDangerIconBrush" Color="#C42B1C" />
        <SolidColorBrush x:Key="ContainerDangerHoverBrush" Color="#18C42B1C" />
        <SolidColorBrush x:Key="ContainerDangerPressedBrush" Color="#28C42B1C" />
        <SolidColorBrush x:Key="ContainerCheckingIndicatorBrush" Color="#0078D4" />

        <Style x:Key="ContainerRowActionStyle" TargetType="ui:Button" BasedOn="{StaticResource ResourceIconButtonStyle}">
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="ContainerDeleteActionStyle" TargetType="ui:Button" BasedOn="{StaticResource ContainerRowActionStyle}">
            <Setter Property="MouseOverBackground" Value="{StaticResource ContainerDangerHoverBrush}" />
            <Setter Property="MouseOverBorderBrush" Value="{StaticResource ContainerDangerHoverBrush}" />
            <Setter Property="PressedBackground" Value="{StaticResource ContainerDangerPressedBrush}" />
            <Setter Property="PressedBorderBrush" Value="{StaticResource ContainerDangerPressedBrush}" />
        </Style>

        <Style x:Key="ContainerSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ContainerColumnHeaderStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ContainerMetricTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Left" />
        </Style>

        <Style x:Key="ContainerStatusIndicatorStyle" TargetType="Border">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{ui:ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="ToolTip" Value="{Binding Container.State}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="Created">
                    <Setter Property="ToolTip" Value="{DynamicResource ContainerListStateCreated}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Exited">
                    <Setter Property="ToolTip" Value="{DynamicResource ContainerListStateExited}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Deleted">
                    <Setter Property="ToolTip" Value="{DynamicResource ContainerListStateDeleted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Invalid">
                    <Setter Property="ToolTip" Value="{DynamicResource ContainerListStateInvalid}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Stopped">
                    <Setter Property="ToolTip" Value="{DynamicResource Stopped}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="RunningWithoutHealthCheck">
                    <Setter Property="ToolTip" Value="{DynamicResource ContainerListRunningWithoutHealth}" />
                    <Setter Property="Background" Value="{ui:ThemeResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Healthy">
                    <Setter Property="ToolTip" Value="{DynamicResource ContainerListRunningHealthy}" />
                    <Setter Property="Background" Value="{ui:ThemeResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Unhealthy">
                    <Setter Property="ToolTip" Value="{DynamicResource ContainerListRunningUnhealthy}" />
                    <Setter Property="Background" Value="{ui:ThemeResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Checking">
                    <Setter Property="ToolTip" Value="{DynamicResource ContainerListRunningChecking}" />
                    <Setter Property="Background" Value="{StaticResource ContainerCheckingIndicatorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="HealthUnknown">
                    <Setter Property="ToolTip" Value="{DynamicResource ContainerListRunningHealthUnknown}" />
                    <Setter Property="Background" Value="{StaticResource ContainerCheckingIndicatorBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding StatusKind}" Value="Other" />
                        <Condition Binding="{Binding Container.State}" Value="" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="ToolTip" Value="{DynamicResource Unknown}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ContainerListItemTemplate">
            <Border MinHeight="62"
                    Padding="14,8"
                    BorderBrush="{ui:ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Background="Transparent"
                    Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.ShowContainerDetailsFromListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding Container}" />
                </Border.InputBindings>
                <Grid x:Name="ContainerRowLayout" Width="{Binding ListLayout.RowWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="{Binding ListLayout.Actions, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </Grid.ColumnDefinitions>
                    <Border ClipToBounds="True">
                        <!-- Measure the full row before clipping so scrolling can reveal every column. -->
                        <Canvas>
                            <Grid x:Name="ContainerRowGrid" Width="{Binding ListLayout.DataWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Left"
                                  Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                  RequestBringIntoView="ScrollableColumns_RequestBringIntoView">
                                <Grid.RenderTransform>
                                    <TranslateTransform X="{Binding HorizontalTranslation, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Grid.RenderTransform>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding ListLayout.Name, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <ColumnDefinition Width="{Binding ListLayout.Image, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <ColumnDefinition Width="{Binding ListLayout.Ports, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <ColumnDefinition Width="{Binding ListLayout.Cpu, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <ColumnDefinition Width="{Binding ListLayout.Memory, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Grid.ColumnDefinitions>

                                <Grid VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border x:Name="ContainerStatusIndicator" Style="{StaticResource ContainerStatusIndicatorStyle}" />
                                    <TextBlock x:Name="ContainerNameText" Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                               AutomationProperties.HelpText="{Binding ToolTip, ElementName=ContainerStatusIndicator}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Container.ShortId}" Style="{StaticResource ContainerSecondaryTextStyle}" FontFamily="Consolas" ToolTip="{Binding Container.Id}" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0" ToolTip="{Binding Image}">
                                    <TextBlock Text="{Binding ImageName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ImageSource}" Style="{StaticResource ContainerSecondaryTextStyle}" />
                                </StackPanel>
                                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="12,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel ToolTip="{Binding ListPorts.FullText}">
                                        <TextBlock Text="{Binding ListPorts.Summary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ListPorts.BindingAddress}" Style="{StaticResource ContainerSecondaryTextStyle}" />
                                    </StackPanel>
                                    <ui:Button x:Name="PortMappingsButton" Grid.Column="1"
                                               Appearance="Transparent" Padding="4,2" Margin="4,0,0,0" MinWidth="26" VerticalAlignment="Center"
                                               Visibility="{Binding ListPorts.HasAdditionalMappings, Converter={StaticResource BoolToVisibility}}"
                                               ToolTip="{DynamicResource ContainerListShowPorts}" AutomationProperties.Name="{DynamicResource ContainerListShowPorts}"
                                               Tag="{Binding ElementName=PortMappingsPopup}" Click="PortMappingsButton_Click">
                                        <TextBlock Text="{Binding ListPorts.AdditionalCount, StringFormat=+{0}}" />
                                    </ui:Button>
                                    <Popup x:Name="PortMappingsPopup" PlacementTarget="{Binding ElementName=PortMappingsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                        <Border Style="{StaticResource ResourceSurfaceStyle}" Padding="14,10" MaxWidth="480">
                                            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding ListPorts.Mappings}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate><TextBlock Text="{Binding FullText}" Margin="0,4" /></DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <TextBlock Grid.Column="3" Text="{Binding Cpu}" Style="{StaticResource ContainerMetricTextStyle}" ToolTip="{Binding Cpu}" />
                                <TextBlock Grid.Column="4" Text="{Binding Memory}" Style="{StaticResource ContainerMetricTextStyle}" ToolTip="{Binding Memory}" />
                            </Grid>
                        </Canvas>
                    </Border>

                    <StackPanel x:Name="ContainerRowActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <ui:Button Icon="{ui:SymbolIcon Symbol=Play24}"
                                   Command="{Binding DataContext.StartContainerFromListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding Container}"
                                   ToolTip="{DynamicResource Start}"
                                   AutomationProperties.Name="{DynamicResource Start}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource ContainerRowActionStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Command="{Binding DataContext.StopContainerFromListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding Container}"
                                   ToolTip="{DynamicResource Stop}"
                                   AutomationProperties.Name="{DynamicResource Stop}">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Stop24" Filled="True" /></ui:Button.Icon>
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource ContainerRowActionStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Icon="{ui:SymbolIcon Symbol=MoreVertical24}"
                                   Style="{StaticResource ContainerRowActionStyle}"
                                   ToolTip="{DynamicResource Actions}"
                                   AutomationProperties.Name="{DynamicResource Actions}"
                                   Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Click="MoreActionsButton_Click">
                            <ui:Button.ContextMenu>
                                <ContextMenu>
                                    <ui:MenuItem Header="{DynamicResource Restart}"
                                              Command="{Binding PlacementTarget.Tag.RestartContainerFromListCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext.Container, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <ui:MenuItem Header="{DynamicResource Details}"
                                              Command="{Binding PlacementTarget.Tag.ShowContainerDetailsFromListCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext.Container, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <ui:MenuItem Header="{DynamicResource Terminal}"
                                              Command="{Binding PlacementTarget.Tag.OpenTerminalFromListCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext.Container, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <ui:MenuItem Header="{DynamicResource Remove}"
                                              Command="{Binding PlacementTarget.Tag.RemoveContainerFromListCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext.Container, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource ContainersTitle}" Style="{StaticResource ResourcePageTitleStyle}" />
                <TextBlock Text="{DynamicResource ContainersSubtitle}" Style="{StaticResource ResourcePageSubtitleStyle}" />
            </StackPanel>
            <ui:Button Grid.Column="1"
                       Content="{DynamicResource CreateContainer}"
                       Icon="{ui:SymbolIcon Symbol=Add24}"
                       Style="{StaticResource ResourcePrimaryButtonStyle}"
                       Command="{Binding ShowCreateContainerCommand}"
                       VerticalAlignment="Top" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox PlaceholderText="{DynamicResource Search}"
                        ClearButtonEnabled="True"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        MinHeight="34"
                        AutomationProperties.Name="{DynamicResource Search}" />
            <controls:SelectorBar Grid.Column="1" SelectedIndex="{Binding ContainerFilterIndex, Mode=TwoWay}" Margin="14,0,8,0">
                <controls:SelectorBarItem Text="{DynamicResource AllResources}" />
                <controls:SelectorBarItem Text="{DynamicResource Running}" />
                <controls:SelectorBarItem Text="{DynamicResource Stopped}" />
            </controls:SelectorBar>
            <ui:Button Grid.Column="2"
                       Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                       Style="{StaticResource ResourceIconButtonStyle}"
                       Command="{Binding RefreshAllCommand}"
                       ToolTip="{DynamicResource Refresh}"
                       AutomationProperties.Name="{DynamicResource Refresh}" />
        </Grid>

        <Grid Grid.Row="2" ClipToBounds="True">
            <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border BorderBrush="{ui:ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0" Width="{Binding ListLayout.RowWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="{Binding ListLayout.Actions, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </Grid.ColumnDefinitions>
                    <Border ClipToBounds="True">
                        <Canvas>
                            <Grid x:Name="ContainerHeaderGrid" Width="{Binding ListLayout.DataWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Left"
                                  Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}">
                                <Grid.RenderTransform>
                                    <TranslateTransform X="{Binding HorizontalTranslation, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Grid.RenderTransform>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding ListLayout.Name, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <ColumnDefinition Width="{Binding ListLayout.Image, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <ColumnDefinition Width="{Binding ListLayout.Ports, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <ColumnDefinition Width="{Binding ListLayout.Cpu, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <ColumnDefinition Width="{Binding ListLayout.Memory, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Name}" Style="{StaticResource ContainerColumnHeaderStyle}" Margin="20,0,12,0" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource Image}" Style="{StaticResource ContainerColumnHeaderStyle}" />
                                <TextBlock Grid.Column="2" Text="{DynamicResource Ports}" Style="{StaticResource ContainerColumnHeaderStyle}" />
                                <TextBlock Grid.Column="3" Text="{DynamicResource Cpu}" Style="{StaticResource ContainerColumnHeaderStyle}" />
                                <TextBlock Grid.Column="4" Text="{DynamicResource Memory}" Style="{StaticResource ContainerColumnHeaderStyle}" />
                            </Grid>
                        </Canvas>
                    </Border>
                    <TextBlock x:Name="ContainerActionsHeader" Grid.Column="1" Text="{DynamicResource Actions}" Style="{StaticResource ContainerColumnHeaderStyle}" TextAlignment="Right" Margin="0" />
                </Grid>
            </Border>
            <ScrollViewer x:Name="ContainerScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" ScrollChanged="ContainerScrollViewer_ScrollChanged">
                <ItemsControl ItemsSource="{Binding VisibleContainerItems}" ItemTemplate="{StaticResource ContainerListItemTemplate}" />
            </ScrollViewer>
            <ScrollBar x:Name="ContainerHorizontalScrollBar" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="14,0,0,2"
                       Width="{Binding ListLayout.RowWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       ViewportSize="{Binding ListLayout.DataViewport, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Maximum="{Binding ListLayout.HorizontalScrollRange, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Visibility="{Binding ListLayout.HasHorizontalOverflow, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"
                       SmallChange="32" LargeChange="128" Focusable="True" ValueChanged="ContainerHorizontalScrollBar_ValueChanged"
                       AutomationProperties.Name="{DynamicResource ContainerListHorizontalScroll}" />
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                <StackPanel.Style>
                    <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding VisibleContainerItems.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ui:FontIcon FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xF5ED;" FontSize="30" Opacity=".55" HorizontalAlignment="Center" />
                <TextBlock Text="{DynamicResource NoContainersTitle}" Style="{StaticResource ResourceEmptyTitleStyle}" />
                <TextBlock Text="{DynamicResource NoContainersHint}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                <ui:Button Content="{DynamicResource CreateContainer}" Icon="{ui:SymbolIcon Symbol=Add24}" Style="{StaticResource ResourcePrimaryButtonStyle}" Command="{Binding ShowCreateContainerCommand}" HorizontalAlignment="Center" Margin="0,16,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
