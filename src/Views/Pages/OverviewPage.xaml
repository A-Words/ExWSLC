<Page x:Class="ExWSLC.Views.Pages.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent"
      Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18,24,28" MaxWidth="1120">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource OverviewTitle}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{DynamicResource OverviewSubtitle}" Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <ui:Button Grid.Column="1" Content="{DynamicResource Refresh}" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" Appearance="Secondary" Command="{Binding RefreshAllCommand}" Padding="14,7" VerticalAlignment="Top" />
            </Grid>

            <Border Style="{StaticResource CardStyle}" Padding="24" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" CornerRadius="14" Background="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,18,0">
                        <ui:FontIcon FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xE7B8;" FontSize="30" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="ExWSLC" FontSize="25" FontWeight="SemiBold"/><Border Background="{DynamicResource AccentFillColorSecondaryBrush}" CornerRadius="5" Padding="8,3" Margin="10,1,0,0"><TextBlock Text="PREVIEW" FontSize="10" FontWeight="SemiBold"/></Border></StackPanel>
                        <TextBlock Text="{DynamicResource HeroDescription}" FontSize="13" Opacity=".66" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Capabilities.Message}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding VersionSummary}" Style="{StaticResource MutedTextStyle}" FontFamily="Consolas" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Columns="5" Margin="0,0,0,4">
                <Border Style="{StaticResource CompactCardStyle}"><StackPanel><TextBlock Text="{DynamicResource Running}" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding RunningContainerCount}" FontSize="27" FontWeight="Light" Foreground="{ui:ThemeResource SystemFillColorSuccessBrush}" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CompactCardStyle}"><StackPanel><TextBlock Text="{DynamicResource Stopped}" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding StoppedContainerCount}" FontSize="27" FontWeight="Light" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CompactCardStyle}"><StackPanel><TextBlock Text="{DynamicResource Images}" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding ImageCount}" FontSize="27" FontWeight="Light" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CompactCardStyle}"><StackPanel><TextBlock Text="{DynamicResource Networks}" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding NetworkCount}" FontSize="27" FontWeight="Light" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CompactCardStyle}" Margin="0,0,0,12"><StackPanel><TextBlock Text="{DynamicResource Volumes}" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding VolumeCount}" FontSize="27" FontWeight="Light" Margin="0,5,0,0"/></StackPanel></Border>
            </UniformGrid>

            <TextBlock Text="{DynamicResource QuickAccess}" Style="{StaticResource SectionTitleStyle}" Margin="0,6,0,12"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <ui:Button Click="OpenContainers_Click" Appearance="Secondary" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Padding="18" Margin="0,0,12,12">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:FontIcon FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xF5ED;" FontSize="23" Margin="0,0,14,0"/><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource NavContainers}" FontSize="16"/><TextBlock Text="{DynamicResource ContainersQuickHint}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"/></StackPanel><ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" VerticalAlignment="Center"/></Grid>
                </ui:Button>
                <ui:Button Grid.Column="1" Click="OpenImages_Click" Appearance="Secondary" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Padding="18" Margin="0,0,0,12">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:FontIcon FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xE7B8;" FontSize="23" Margin="0,0,14,0"/><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource NavImages}" FontSize="16"/><TextBlock Text="{DynamicResource ImagesQuickHint}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"/></StackPanel><ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" VerticalAlignment="Center"/></Grid>
                </ui:Button>
                <ui:Button Grid.Row="1" Click="OpenResources_Click" Appearance="Secondary" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Padding="18" Margin="0,0,12,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:FontIcon FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xE774;" FontSize="23" Margin="0,0,14,0"/><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource NavResources}" FontSize="16"/><TextBlock Text="{DynamicResource ResourcesQuickHint}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"/></StackPanel><ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" VerticalAlignment="Center"/></Grid>
                </ui:Button>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CompactCardStyle}" Margin="0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Pulse24" FontSize="23" Margin="0,0,14,0"/><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource LiveStats}" FontSize="16"/><TextBlock Text="{Binding Stats.Count, StringFormat={}{0} active snapshots}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"/></StackPanel></Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
