<Page x:Class="ExWSLC.Views.Pages.VolumesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:designViewModels="clr-namespace:ExWSLC.ViewModels.Design"
      x:Name="RootPage"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=designViewModels:DesignVolumesViewModel, IsDesignTimeCreatable=True}"
      Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18,24,28">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource VolumesTitle}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{DynamicResource VolumesSubtitle}" Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Top">
                    <ui:Button Content="{DynamicResource Prune}"
                               Icon="{ui:SymbolIcon Symbol=Delete24}"
                               Appearance="Secondary"
                               Command="{Binding PruneVolumesCommand}"
                               Margin="0,0,8,0" />
                    <ui:Button Content="{DynamicResource Refresh}"
                               Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                               Appearance="Secondary"
                               Command="{Binding RefreshAllCommand}" />
                </WrapPanel>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:FontIcon FontFamily="{DynamicResource SegoeFluentIcons}"
                                     Glyph="&#xEDA2;"
                                     FontSize="23"
                                     Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource CreateVolume}" FontSize="16" />
                            <TextBlock Text="{DynamicResource CreateVolumeHint}" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <ui:Button Grid.Column="2"
                                   Content="{DynamicResource Create}"
                                   Appearance="Primary"
                                   Command="{Binding CreateVolumeCommand}"
                                   VerticalAlignment="Top" />
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="VolumeNameLabel" Text="{DynamicResource VolumeNameOptional}" />
                            <ui:TextBox Text="{Binding VolumeName}"
                                        PlaceholderText="{DynamicResource VolumeName}"
                                        AutomationProperties.LabeledBy="{Binding ElementName=VolumeNameLabel}"
                                        Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="VolumeDriverLabel" Text="{DynamicResource VolumeDriver}" />
                            <ui:TextBox Text="{Binding VolumeDriver}"
                                        PlaceholderText="guest"
                                        AutomationProperties.LabeledBy="{Binding ElementName=VolumeDriverLabel}"
                                        Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>

                    <Expander Header="{DynamicResource Advanced}" Margin="0,14,0,0">
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="VolumeOptionsLabel" Text="{DynamicResource DriverOptions}" />
                                <TextBlock Text="{DynamicResource VolumeOptionsHint}" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,5" />
                                <ui:TextBox Text="{Binding VolumeOptions}"
                                            AcceptsReturn="True"
                                            Height="72"
                                            PlaceholderText="key=value"
                                            AutomationProperties.LabeledBy="{Binding ElementName=VolumeOptionsLabel}"
                                            AutomationProperties.HelpText="{DynamicResource VolumeOptionsHint}"
                                            VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="VolumeLabelsLabel" Text="{DynamicResource Labels}" />
                                <TextBlock Text="{DynamicResource VolumeLabelsHint}" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,5" />
                                <ui:TextBox Text="{Binding VolumeLabels}"
                                            AcceptsReturn="True"
                                            Height="72"
                                            PlaceholderText="key=value"
                                            AutomationProperties.LabeledBy="{Binding ElementName=VolumeLabelsLabel}"
                                            AutomationProperties.HelpText="{DynamicResource VolumeLabelsHint}"
                                            VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Grid>
                    </Expander>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CompactCardStyle}" Margin="0,0,0,14">
                <Expander Header="{DynamicResource VolumeCleanupOptions}">
                    <StackPanel Margin="0,10,0,0">
                        <CheckBox Content="{DynamicResource ForceVolumeRemoval}"
                                  IsChecked="{Binding ForceVolumeRemoval}" />
                        <CheckBox Content="{DynamicResource PruneAllVolumes}"
                                  IsChecked="{Binding PruneAllVolumes}"
                                  Margin="0,8,0,0" />
                        <TextBlock x:Name="VolumePruneFiltersLabel"
                                   Text="{DynamicResource VolumePruneFilters}"
                                   Margin="0,12,0,0" />
                        <TextBlock Text="{DynamicResource VolumePruneFiltersHint}"
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,2,0,5" />
                        <ui:TextBox Text="{Binding VolumePruneFilters}"
                                    AcceptsReturn="True"
                                    Height="62"
                                    PlaceholderText="label=environment=development"
                                    AutomationProperties.LabeledBy="{Binding ElementName=VolumePruneFiltersLabel}"
                                    AutomationProperties.HelpText="{DynamicResource VolumePruneFiltersHint}"
                                    VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Expander>
            </Border>

            <Border Style="{StaticResource LayerCardStyle}" Margin="0" Padding="0">
                <Grid MinHeight="260">
                    <DataGrid ItemsSource="{Binding Volumes}"
                              SelectedItem="{Binding SelectedVolume}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="name" Binding="{Binding Name}" Width="1.1*">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate><TextBlock Text="{DynamicResource VolumeName}" /></DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="driver" Binding="{Binding DisplayDriver}" Width=".75*">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate><TextBlock Text="{DynamicResource Driver}" /></DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="size" Binding="{Binding DisplaySize}" Width=".75*">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate><TextBlock Text="{DynamicResource Size}" /></DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="mountpoint" Width="2*">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate><TextBlock Text="{DynamicResource Mountpoint}" /></DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayMountpoint}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayMountpoint}"
                                                   Margin="4" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="actions" Width="Auto">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate><TextBlock Text="{DynamicResource Actions}" /></DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4">
                                            <ui:Button Content="{DynamicResource Inspect}"
                                                       Appearance="Secondary"
                                                       Command="{Binding DataContext.InspectVolumeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding}"
                                                       Margin="0,0,6,0" />
                                            <ui:Button Content="{DynamicResource Remove}"
                                                       Appearance="Danger"
                                                       Command="{Binding DataContext.RemoveVolumeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <ui:FontIcon FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xEDA2;" FontSize="30" Opacity=".55" />
                        <TextBlock Text="{DynamicResource NoVolumes}" Margin="0,10,0,0" Style="{StaticResource MutedTextStyle}" />
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Volumes.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Visibility="{Binding HasInspectOutput, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{DynamicResource VolumeInspectOutput}" Style="{StaticResource SectionTitleStyle}" Margin="0,20,0,10" />
                <ui:TextBox Text="{Binding InspectOutput, Mode=OneWay}"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            FontFamily="Consolas"
                            MinHeight="120"
                            AutomationProperties.Name="{DynamicResource VolumeInspectOutput}"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto" />
            </StackPanel>
            <StackPanel Visibility="{Binding HasOperationOutput, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{DynamicResource OperationOutput}" Style="{StaticResource SectionTitleStyle}" Margin="0,16,0,10" />
                <ui:TextBox Text="{Binding OperationOutput, Mode=OneWay}"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            FontFamily="Consolas"
                            MinHeight="120"
                            AutomationProperties.Name="{DynamicResource OperationOutput}"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
