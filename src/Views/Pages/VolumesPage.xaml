<Page x:Class="ExWSLC.Views.Pages.VolumesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:designViewModels="clr-namespace:ExWSLC.ViewModels.Design"
      x:Name="RootPage" mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=designViewModels:DesignVolumesViewModel, IsDesignTimeCreatable=True}"
      Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18,24,28">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{DynamicResource VolumesTitle}" Style="{StaticResource ResourcePageTitleStyle}" /><TextBlock Text="{DynamicResource VolumesSubtitle}" Style="{StaticResource ResourcePageSubtitleStyle}" /></StackPanel>
                <ui:Button Grid.Column="1" Content="{DynamicResource CreateVolume}" Icon="{ui:SymbolIcon Symbol=Add24}" Style="{StaticResource ResourcePrimaryButtonStyle}" Click="CreateVolumeButton_Click" VerticalAlignment="Top" />
            </Grid>
            <Border Style="{StaticResource ResourceToolbarStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{DynamicResource SearchVolumes}" ClearButtonEnabled="True" MinHeight="34" AutomationProperties.Name="{DynamicResource SearchVolumes}" />
                    <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" Style="{StaticResource ResourceIconButtonStyle}" Command="{Binding RefreshAllCommand}" ToolTip="{DynamicResource Refresh}" AutomationProperties.Name="{DynamicResource Refresh}" Margin="8,0,0,0" />
                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Symbol=MoreVertical24}" Style="{StaticResource ResourceIconButtonStyle}" ToolTip="{DynamicResource Actions}" AutomationProperties.Name="{DynamicResource Actions}" Margin="8,0,0,0" Tag="{Binding}" Click="OpenContextMenuButton_Click">
                        <ui:Button.ContextMenu><ContextMenu><MenuItem Header="{DynamicResource Prune}" Command="{Binding PlacementTarget.Tag.PruneVolumesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" /></ContextMenu></ui:Button.ContextMenu>
                    </ui:Button>
                </Grid>
            </Border>
            <Border Style="{StaticResource ResourceSurfaceStyle}">
                <Grid MinHeight="300">
                    <DataGrid ItemsSource="{Binding VisibleVolumes}" SelectedItem="{Binding SelectedVolume}" Style="{StaticResource ResourceDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="name" Binding="{Binding Name}" Width="1.1*"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{DynamicResource VolumeName}" /></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn>
                            <DataGridTextColumn Header="driver" Binding="{Binding DisplayDriver}" Width=".75*"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{DynamicResource Driver}" /></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn>
                            <DataGridTextColumn Header="size" Binding="{Binding DisplaySize}" Width=".75*"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{DynamicResource Size}" /></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn>
                            <DataGridTemplateColumn Header="mountpoint" Width="2*"><DataGridTemplateColumn.HeaderTemplate><DataTemplate><TextBlock Text="{DynamicResource Mountpoint}" /></DataTemplate></DataGridTemplateColumn.HeaderTemplate><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding DisplayMountpoint}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayMountpoint}" Margin="6" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="actions" Width="Auto">
                                <DataGridTemplateColumn.HeaderTemplate><DataTemplate><TextBlock Text="{DynamicResource Actions}" /></DataTemplate></DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><ui:Button Icon="{ui:SymbolIcon Symbol=MoreVertical24}" Style="{StaticResource ResourceIconButtonStyle}" ToolTip="{DynamicResource Actions}" AutomationProperties.Name="{DynamicResource Actions}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}" Click="OpenContextMenuButton_Click" Margin="6,0"><ui:Button.ContextMenu><ContextMenu><MenuItem Header="{DynamicResource Remove}" Command="{Binding PlacementTarget.Tag.RemoveVolumeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" /></ContextMenu></ui:Button.ContextMenu></ui:Button></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding VisibleVolumes.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <ui:FontIcon FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xEDA2;" FontSize="30" Opacity=".55" HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource NoVolumes}" Style="{StaticResource ResourceEmptyTitleStyle}" />
                        <ui:Button Content="{DynamicResource CreateVolume}" Icon="{ui:SymbolIcon Symbol=Add24}" Style="{StaticResource ResourcePrimaryButtonStyle}" HorizontalAlignment="Center" Margin="0,12,0,0" Click="CreateVolumeButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
