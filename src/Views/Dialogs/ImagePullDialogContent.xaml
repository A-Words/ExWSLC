<UserControl x:Class="ExWSLC.Views.Dialogs.ImagePullDialogContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">
    <StackPanel Width="440" Margin="0,8,0,0">
        <TextBlock Text="{DynamicResource PullHint}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
        <TextBlock x:Name="ImageReferenceLabel" Text="{DynamicResource ImageReference}" />
        <ui:TextBox Text="{Binding ImageReference, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ubuntu:latest" AutomationProperties.LabeledBy="{Binding ElementName=ImageReferenceLabel}" Margin="0,5,0,0" />
    </StackPanel>
</UserControl>
