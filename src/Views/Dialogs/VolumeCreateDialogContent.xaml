<UserControl x:Class="ExWSLC.Views.Dialogs.VolumeCreateDialogContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">
    <StackPanel Width="520" Margin="0,8,0,0">
        <TextBlock Text="{DynamicResource CreateVolumeHint}" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,18" />
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="VolumeNameLabel" Text="{DynamicResource VolumeNameOptional}" />
                <ui:TextBox Text="{Binding VolumeName}" PlaceholderText="{DynamicResource VolumeName}" AutomationProperties.LabeledBy="{Binding ElementName=VolumeNameLabel}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock x:Name="VolumeDriverLabel" Text="{DynamicResource VolumeDriver}" />
                <ui:TextBox Text="{Binding VolumeDriver}" PlaceholderText="guest" AutomationProperties.LabeledBy="{Binding ElementName=VolumeDriverLabel}" Margin="0,5,0,0" />
            </StackPanel>
        </Grid>
        <Expander Header="{DynamicResource Advanced}" Margin="0,16,0,0">
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="VolumeOptionsLabel" Text="{DynamicResource DriverOptions}" />
                    <TextBlock Text="{DynamicResource VolumeOptionsHint}" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,5" />
                    <ui:TextBox Text="{Binding VolumeOptions}" AcceptsReturn="True" Height="90" PlaceholderText="key=value" AutomationProperties.LabeledBy="{Binding ElementName=VolumeOptionsLabel}" AutomationProperties.HelpText="{DynamicResource VolumeOptionsHint}" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="VolumeLabelsLabel" Text="{DynamicResource Labels}" />
                    <TextBlock Text="{DynamicResource VolumeLabelsHint}" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,5" />
                    <ui:TextBox Text="{Binding VolumeLabels}" AcceptsReturn="True" Height="90" PlaceholderText="key=value" AutomationProperties.LabeledBy="{Binding ElementName=VolumeLabelsLabel}" AutomationProperties.HelpText="{DynamicResource VolumeLabelsHint}" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Grid>
        </Expander>
    </StackPanel>
</UserControl>
