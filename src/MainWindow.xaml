<ui:FluentWindow x:Class="ExWSLC.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:ExWSLC.Views.Pages"
                 xmlns:containerPages="clr-namespace:ExWSLC.Views.Pages.Containers"
                 Title="ExWSLC" Width="1100" Height="800"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type ui:FluentWindow}}}"
                     CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:FontIcon FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xE7B8;" FontSize="18" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           Background="{ui:ThemeResource ApplicationBackgroundBrush}"
                           OpenPaneLength="220"
                           IsBackButtonVisible="Collapsed">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{DynamicResource NavOverview}" NavigationCacheMode="Enabled" TargetPageType="{x:Type pages:OverviewPage}">
                    <ui:NavigationViewItem.Icon><ui:FontIcon FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xE80F;" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource NavContainers}" NavigationCacheMode="Enabled" TargetPageType="{x:Type containerPages:ContainersPage}">
                    <ui:NavigationViewItem.Icon><ui:FontIcon FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xF5ED;" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource NavImages}" NavigationCacheMode="Enabled" TargetPageType="{x:Type pages:ImagesPage}">
                    <ui:NavigationViewItem.Icon><ui:FontIcon FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xE7B8;" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource NavNetworks}" NavigationCacheMode="Enabled" TargetPageType="{x:Type pages:NetworksPage}">
                    <ui:NavigationViewItem.Icon><ui:FontIcon FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xE774;" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource NavVolumes}" NavigationCacheMode="Enabled" TargetPageType="{x:Type pages:VolumesPage}">
                    <ui:NavigationViewItem.Icon><ui:FontIcon FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xEDA2;" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource NavTasks}" NavigationCacheMode="Enabled" TargetPageType="{x:Type pages:TasksPage}">
                    <ui:NavigationViewItem.Icon><ui:FontIcon FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xE9D9;" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{DynamicResource NavSettings}" NavigationCacheMode="Enabled" TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon><ui:FontIcon FontFamily="{DynamicResource SegoeFluentIcons}" Glyph="&#xE713;" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <ui:ContentDialogHost x:Name="RootContentDialogHost"
                              Grid.RowSpan="2"
                              IsDisableSiblingsEnabled="True" />

    </Grid>
</ui:FluentWindow>
